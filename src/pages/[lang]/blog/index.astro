---
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articlesByDate, diarySections } from "../../../data/articles";
import { learningSeries } from "../../../data/learningSeries";
import { tier1Locales, type Tier1Locale, getLocalizedArticle } from "../../../utils/i18n";
import { tier1Content } from "../../../data/tier1Translations";
import { buildItemListJsonLd, buildSectionCollectionJsonLd } from "../../../utils/structuredData";

export function getStaticPaths() {
  return tier1Locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Tier1Locale;
const content = tier1Content[locale] ?? tier1Content["ja"];

const articlesPerPage = 15;
const workbuddy = learningSeries.find((series) => series.id === "workbuddy")!;
const cola = learningSeries.find((series) => series.id === "cola")!;
const localizedArticles = articlesByDate.map((article) => getLocalizedArticle(article, "en"));
const comprehensiveArticles = localizedArticles.filter((article) => article.diaryKind !== "video");
const comprehensivePageCount = Math.ceil(comprehensiveArticles.length / articlesPerPage);
const courseArticles = new Map(localizedArticles.filter((article) => article.diaryKind === "video").map((article) => [article.slug, article]));

const tabTitles: Record<Tier1Locale, Record<string, { title: string; subtitle: string }>> = {
  ja: {
    workbuddy: { title: "WorkBuddy AIオフィス自動化チュートリアル", subtitle: "Excel、Word、PPTの自動化実戦を体系的に学ぶAIオフィスワークフロー講座。" },
    cola: { title: "Codex プログラミングチュートリアル", subtitle: "Codex、Claude Code、ChatGPTを活用した実戦プログラミングとAI開発記録。" },
    other: { title: "AI総合学習", subtitle: "実戦開発、ブラウザ自動化、プロダクト開発、読書記録と思考ノート。タグ検索対応・最新順。" },
  },
  ko: {
    workbuddy: { title: "WorkBuddy AI 오피스 튜토리얼", subtitle: "Excel, PPT, Word 자동화 실무를 체계적으로 마스터하는 AI 오피스 튜토리얼." },
    cola: { title: "Codex 프로그래밍 튜토리얼", subtitle: "Codex, Claude Code, ChatGPT를 활용한 실전 코딩 및 AI 개발 일지." },
    other: { title: "AI 종합 학습", subtitle: "실전 개발, 브라우저 자동화, 제품 개발, 독서 노트와 에세이. 태그별 검색 및 최신순 정렬." },
  },
  es: {
    workbuddy: { title: "Tutoriales de Automatización de Oficina WorkBuddy AI", subtitle: "Aprende flujos de trabajo prácticos para automatizar Excel, PPT y Word desde cero." },
    cola: { title: "Tutoriales de Programación con Codex & IA", subtitle: "Guías prácticas y flujos de trabajo con Codex, Claude Code, Gemini y ChatGPT." },
    other: { title: "Aprendizaje Integral de IA", subtitle: "Casos prácticos, automatización de navegadores, desarrollo de productos y notas de reflexión." },
  },
  fr: {
    workbuddy: { title: "Tutoriels Bureautique WorkBuddy AI", subtitle: "Maîtrisez l'automatisation d'Excel, Word et PowerPoint étape par étape." },
    cola: { title: "Tutoriels de Code avec Codex & IA", subtitle: "Guides pratiques avec Codex, Claude Code, Gemini et ChatGPT." },
    other: { title: "Apprentissage Complet de l'IA", subtitle: "Pratique réelle, automatisation de navigateur, développement de produits et réflexions." },
  },
  de: {
    workbuddy: { title: "WorkBuddy KI-Büroautomation Tutorials", subtitle: "Praktische Büro-KI-Tutorials zur Automatisierung von Excel, Word und PowerPoint." },
    cola: { title: "Codex & KI-Coding Tutorials", subtitle: "Praxisnahe Programmier-Tutorials mit Codex, Claude Code und ChatGPT." },
    other: { title: "Umfassendes KI-Lernen", subtitle: "Praxisnahe Entwicklung, Browser-Automation, Produktentwicklung und Denknotizen." },
  },
  pt: {
    workbuddy: { title: "Tutoriais de Automação de Escritório WorkBuddy IA", subtitle: "Aprenda fluxos de trabalho práticos para automatizar Excel, PPT e Word." },
    cola: { title: "Tutoriais de Programação com Codex & IA", subtitle: "Guias práticos com Codex, Claude Code, Gemini e ChatGPT." },
    other: { title: "Aprendizado Abrangente de IA", subtitle: "Casos práticos, automação de navegador, desenvolvimento de produtos e notas de campo." },
  },
  ru: {
    workbuddy: { title: "Руководства по автоматизации офиса с WorkBuddy", subtitle: "Практические руководства по автоматизации Excel, Word и PowerPoint с помощью ИИ." },
    cola: { title: "Руководства по кодингу с Codex и ИИ", subtitle: "Практические инструкции по программированию с Codex, Claude Code и ChatGPT." },
    other: { title: "Комплексное обучение ИИ", subtitle: "Практическая разработка, автоматизация браузера, создание продуктов и заметки." },
  },
  it: {
    workbuddy: { title: "Tutorial di Automazione d'Ufficio WorkBuddy AI", subtitle: "Guide pratiche per automatizzare Excel, Word e PowerPoint passo dopo passo." },
    cola: { title: "Tutorial di Programmazione con Codex & AI", subtitle: "Guide pratiche con Codex, Claude Code, Gemini e ChatGPT." },
    other: { title: "Apprendimento Completo dell'IA", subtitle: "Pratica sul campo, automazione del browser, sviluppo prodotti e riflessioni." },
  },
  ar: {
    workbuddy: { title: "دروس أتمتة المكاتب مع WorkBuddy", subtitle: "تعلم أتمتة مهام Excel و Word و PowerPoint عملياً خطوة بخطوة." },
    cola: { title: "دروس البرمجة مع Codex والذكاء الاصطناعي", subtitle: "أدلة برمجية وتطبيقات عملية مع Codex و Claude Code و ChatGPT." },
    other: { title: "تعلم الذكاء الاصطناعي الشامل", subtitle: "تطبيقات عملية، أتمتة المتصفح، تطوير المنتجات والملاحظات الميدانية." },
  },
  hi: {
    workbuddy: { title: "WorkBuddy AI ऑफिस ऑटोमेशन ट्यूटोरियल", subtitle: "Excel, PPT और Word कार्यों को स्वचालित करने के व्यावहारिक ट्यूटोरियल।" },
    cola: { title: "Codex और AI कोडिंग ट्यूटोरियल", subtitle: "Codex, Claude Code और ChatGPT के साथ व्यावहारिक प्रोग्रामिंग कार्यप्रवाह।" },
    other: { title: "एआई व्यापक अध्ययन", subtitle: "व्यावहारिक विकास, ब्राउज़र ऑटोमेशन, उत्पाद निर्माण और विचार नोट्स।" },
  },
};

const currentTabTitles = tabTitles[locale] ?? tabTitles.ja;
const pageDescription = currentTabTitles.workbuddy.subtitle;

const jsonLd = [
  buildSectionCollectionJsonLd({
    locale,
    path: `/${locale}/blog`,
    name: `@Hooosberg ${currentTabTitles.workbuddy.title}`,
    description: pageDescription,
    topics: ["AI automation", "WorkBuddy", "Codex", "AI Agents", "Claude Code"],
  }),
  buildItemListJsonLd(
    `https://hooosberg.com/${locale}/blog#learning-notes`,
    localizedArticles.filter((article) => article.diaryKind === "video").map((article) => ({
      name: article.title,
      url: `/en/blog/${article.slug}`,
      description: article.excerpt,
    }))
  ),
];
---

<BaseLayout locale={locale} title={`${currentTabTitles.workbuddy.title} | @Hooosberg`} description={pageDescription} canonicalPath={`/${locale}/blog`} jsonLd={jsonLd}>
  <section class="page-hero page-hero--narrow learning-hero">
    <h1 id="learning-hero-title">{currentTabTitles.workbuddy.title}</h1>
    <p id="learning-hero-subtitle" class="learning-hero-subtitle">{currentTabTitles.workbuddy.subtitle}</p>
  </section>

  <section class="learning-index" aria-label="Learning notes sections">
    <div class="learning-switch" role="tablist" aria-label="Learning paths">
      <button class="learning-tab" type="button" role="tab" aria-selected="true" data-learning-tab="workbuddy" data-title={currentTabTitles.workbuddy.title} data-subtitle={currentTabTitles.workbuddy.subtitle}>{currentTabTitles.workbuddy.title}</button>
      <button class="learning-tab" type="button" role="tab" aria-selected="false" data-learning-tab="cola" data-title={currentTabTitles.cola.title} data-subtitle={currentTabTitles.cola.subtitle}>{currentTabTitles.cola.title}</button>
      <button class="learning-tab" type="button" role="tab" aria-selected="false" data-learning-tab="other" data-title={currentTabTitles.other.title} data-subtitle={currentTabTitles.other.subtitle}>{currentTabTitles.other.title}</button>
    </div>

    <section class="learning-panel" data-learning-panel="workbuddy">
      <div class="learning-list-header">
        <div>
          <p>Public Series · 30 lessons syllabus</p>
          <h3>Browse titles, outlines, and companion notes by lesson</h3>
        </div>
        <span>Each lesson includes copyable prompts and verification standards in English.</span>
      </div>
      <div class="learning-lesson-list">
        {[...workbuddy.lessons].reverse().map((lesson) => {
          const article = lesson.articleSlug ? courseArticles.get(lesson.articleSlug) : undefined;
          const displayName = article ? article.title.replace(/^Video Tutorial Notes · /i, "") : lesson.title;
          const href = article ? `/en/blog/${article.slug}?kind=video` : (lesson.videoUrl || workbuddy.playlistUrl);
          return <a class="learning-lesson-row" href={href} target={article ? undefined : "_blank"} rel={article ? undefined : "noreferrer"}>
            <span class="learning-lesson-number">{String(lesson.number).padStart(2, "0")}</span>
            <span class="learning-lesson-copy"><strong>{displayName}</strong><small>{lesson.outcome}</small></span>
            {lesson.hasDownload && <span class="learning-download-flag">Resource</span>}
            <ArrowUpRight size={17} aria-hidden="true" />
          </a>;
        })}
      </div>
    </section>

    <section class="learning-panel" data-learning-panel="cola" hidden>
      <div class="learning-list-header">
        <div>
          <p>Codex / ChatGPT practice series · {cola.lessons.length} lessons</p>
          <h3>Explore notes, prompts, and walkthroughs by project case</h3>
        </div>
        <span>Problem-led practice with verifiable deliverables.</span>
      </div>
      <div class="learning-lesson-list">
        {cola.lessons.map((lesson) => {
          const article = lesson.articleSlug ? courseArticles.get(lesson.articleSlug) : undefined;
          const displayName = article ? article.title.replace(/^Video Tutorial Notes · /i, "") : lesson.title;
          const href = article ? `/en/blog/${article.slug}?kind=video` : (lesson.videoUrl || cola.playlistUrl);
          const isPinned = lesson.isPinned;
          return <a class={`learning-lesson-row ${isPinned ? "learning-lesson-row--pinned" : ""}`} href={href} target={article ? undefined : "_blank"} rel={article ? undefined : "noreferrer"}>
            <span class={`learning-lesson-number ${isPinned ? "learning-lesson-number--pinned" : ""}`}>{isPinned ? "PIN" : String(lesson.number).padStart(2, "0")}</span>
            <span class="learning-lesson-copy"><strong>{displayName}</strong><small>{lesson.outcome}</small></span>
            {isPinned && <span class="learning-pinned-flag">Featured</span>}
            {lesson.hasDownload && <span class="learning-download-flag">Resource</span>}
            <ArrowUpRight size={17} aria-hidden="true" />
          </a>;
        })}
      </div>
    </section>

    <section class="learning-panel" data-learning-panel="other" hidden>
      <div class="article-list article-list--other">
        {comprehensiveArticles.map((article, articleIndex) => (
          <a class="article-row" href={`/en/blog/${article.slug}`} data-comp-row data-comp-page={Math.floor(articleIndex / articlesPerPage) + 1} hidden={articleIndex >= articlesPerPage}>
            <span class="article-row__category">{article.tags[0] ?? article.category}</span>
            <span class="article-row__title">{article.title}</span>
            <span class="article-row__excerpt">{article.excerpt}</span>
            <span class="article-row__date">{article.date}</span>
          </a>
        ))}
      </div>
      {comprehensivePageCount > 1 && (
        <nav class="diary-pagination" aria-label="AI Comprehensive Learning pagination" data-comp-pagination>
          {Array.from({ length: comprehensivePageCount }, (_, pageIndex) => (
            <button class="diary-page-button" type="button" data-comp-page-button data-comp-page={pageIndex + 1} aria-current={pageIndex === 0 ? "page" : undefined}>
              {pageIndex + 1}
            </button>
          ))}
        </nav>
      )}
    </section>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const heroTitle = document.getElementById("learning-hero-title");
    const heroSubtitle = document.getElementById("learning-hero-subtitle");
    const panels = Array.from(document.querySelectorAll("[data-learning-panel]"));
    const tabs = Array.from(document.querySelectorAll("[data-learning-tab]"));
    const compRows = Array.from(document.querySelectorAll("[data-comp-row]"));
    const compPageButtons = Array.from(document.querySelectorAll("[data-comp-page-button]"));

    const setPanel = (name) => {
      const targetName = (name === "comprehensive") ? "other" : name;
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.learningPanel !== targetName;
      });
      tabs.forEach((tab) => {
        const isSelected = tab.dataset.learningTab === targetName;
        tab.setAttribute("aria-selected", String(isSelected));
        if (isSelected) {
          const tabTitle = tab.dataset.title || tab.textContent.trim();
          if (heroTitle) heroTitle.textContent = tabTitle;
          if (heroSubtitle && tab.dataset.subtitle) heroSubtitle.textContent = tab.dataset.subtitle;
        }
      });
      const url = new URL(window.location.href);
      url.searchParams.set("section", targetName);
      window.history.replaceState({}, "", `${url.pathname}${url.search}`);
    };

    const setCompPage = (page = 1) => {
      compRows.forEach((row) => {
        row.hidden = Number(row.dataset.compPage || "1") !== page;
      });
      compPageButtons.forEach((button) => {
        button.setAttribute("aria-current", String(Number(button.dataset.compPage) === page));
      });
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => setPanel(tab.dataset.learningTab)));
    compPageButtons.forEach((button) => button.addEventListener("click", () => setCompPage(Number(button.dataset.compPage))));

    const searchParams = new URLSearchParams(window.location.search);
    const rawKind = searchParams.get("kind");
    const rawInitial = searchParams.get("section") || (rawKind ? (["product", "reading", "thought", "resources"].includes(rawKind) ? "other" : rawKind) : null);
    const initial = (rawInitial === "comprehensive") ? "other" : rawInitial;
    if (initial && tabs.some((tab) => tab.dataset.learningTab === initial)) {
      setPanel(initial);
    } else {
      const activeTab = tabs.find((tab) => tab.getAttribute("aria-selected") === "true");
      if (activeTab) {
        if (heroTitle && activeTab.dataset.title) {
          heroTitle.textContent = activeTab.dataset.title;
        }
        if (heroSubtitle && activeTab.dataset.subtitle) {
          heroSubtitle.textContent = activeTab.dataset.subtitle;
        }
      }
    }
    setCompPage(1);
  })();
</script>

<style>
  .learning-hero-subtitle {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }
</style>
