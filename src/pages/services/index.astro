---
import {
  ArrowRight,
  Wrench,
  UserRoundCog,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildSectionWebPageJsonLd } from "../../utils/structuredData";

const services = [
  {
    title: "WorkBuddy 专家定制",
    description: "根据你的业务目标和日常工作方式，定制 WorkBuddy 的使用方案、任务流程与专家级协作方法。",
    price: "1500 元",
    note: "一对一梳理需求，交付可直接执行的定制方案",
    icon: UserRoundCog,
  },
  {
    title: "WorkBuddy 技能定制",
    description: "围绕具体任务设计和配置 WorkBuddy 技能，让重复工作形成稳定、可复用的工作流。",
    price: "1500 元",
    note: "按实际使用场景定制技能与操作说明",
    icon: Wrench,
  },
];
const pageDescription = "湖森堡AI_hooosberg 提供 WorkBuddy 专家定制与技能定制服务。";
const jsonLd = buildSectionWebPageJsonLd({
  locale: "zh-CN",
  path: "/services",
  name: "湖森堡 WorkBuddy 定制服务",
  description: pageDescription,
  topics: ["WorkBuddy custom service", "WorkBuddy expert customization", "WorkBuddy skill customization"],
});
---

<BaseLayout title="定制服务 | 湖森堡AI_hooosberg" description={pageDescription} jsonLd={jsonLd}>
  <section class="page-hero page-hero--narrow courses-hero commerce-hero">
    <h1>定制服务</h1>
    <p>
      围绕你的实际工作场景，提供 WorkBuddy 专家定制和技能定制服务，帮助你更高效地使用 AI 完成任务。
    </p>
  </section>

  <section class="catalog-section commerce-section service-section">
    <div class="section-line-heading course-section-heading commerce-section-heading">
      <h2>定制项目</h2>
      <span>1500 元</span>
    </div>

    <div class="service-grid commerce-card-grid">
      {services.map((service) => {
        const Icon = service.icon;

        return (
          <article class="service-card commerce-card">
            <div class="commerce-card__top">
              <div class="course-icon"><Icon size={20} aria-hidden="true" /></div>
              <span>WorkBuddy 定制</span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="service-card__footer commerce-card__footer">
              <div>
                <strong>{service.price}</strong>
                <small>{service.note}</small>
              </div>
              <a class="commerce-action" href="/links">
                咨询
                <ArrowRight size={15} aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
