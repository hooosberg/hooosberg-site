---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CourseCard from "../../components/CourseCard.astro";
import { courseCatalog } from "../../data/courseCatalog";
import { buildSectionWebPageJsonLd } from "../../utils/structuredData";
const description = "从办公入门到管理岗实战，选择适合你的 AI 课程，跟着真实业务场景动手练习。";
const jsonLd = buildSectionWebPageJsonLd({ locale: "zh-CN", path: "/courses", name: "湖森堡 AI 课程", description, topics: ["AI coding course", "AI office automation course", "AI management course"] });
---
<BaseLayout locale="zh-CN" title="更多课程 | 湖森堡AI_hooosberg" description={description} jsonLd={jsonLd}>
  <section class="page-hero page-hero--narrow course-catalog-hero"><p class="commerce-kicker">HOOOSBERG / COURSES</p><h1>选一门课，解决眼前的事</h1><p>{description}</p></section>
  <section class="course-shop-grid" aria-label="课程列表">{courseCatalog.map((course) => <CourseCard course={course} english={false} />)}</section>
</BaseLayout>
