---
import { ArrowRight, BookOpen, ExternalLink } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioAbout from "../../components/StudioAbout.astro";
import { getLocalizedSocialLinks } from "../../utils/i18n";
import { buildHomeJsonLd } from "../../utils/structuredData";

import CourseCard from "../../components/CourseCard.astro";
import { courseCatalog } from "../../data/courseCatalog";

const bilibiliCourseUrl =
  "https://www.bilibili.com/cheese/play/ss402180572?csource=private_space_class_null&spm_id_from=333.1387.0.0";
const curriculumNoteUrl = "/en/blog?section=paid";

const localizedSocialLinks = getLocalizedSocialLinks("en");
const socialCards = localizedSocialLinks
  .filter((link) => link.originalLabel !== "Email")
  .map((link) => ({ label: link.label, value: link.note, url: link.url, icon: link.icon }));

---

<BaseLayout
  locale="en"
  title="Hooosberg | AI Office Automation: AI Agents & Practical Workflows Course"
  description="A comprehensive AI office agent curriculum based on Tencent WorkBuddy. 4 parts, 23 lessons, 23 practice packs. Deliver real, verifiable work files from day one."
  canonicalPath="/en"
  jsonLd={buildHomeJsonLd("en")}
>
  <section class="landing-hero landing-hero--course">
    <div class="hero-grid course-hero__grid" aria-hidden="true"></div>
    <div class="course-hero"><div class="course-hero__copy">
      <h1>AI Office Essentials</h1><p class="course-hero__lead">No coding required. Start with the work in front of you.</p><p class="course-hero__choice">Learn a practical way to use AI in your daily work.</p>
      <div class="hero-actions course-hero__actions">
        <a class="button button--primary button--xl" href={bilibiliCourseUrl} target="_blank" rel="noreferrer">Start learning<ArrowRight size={17} /></a>
        <a class="button button--secondary" href="/en/courses">Other courses<ArrowRight size={15} /></a>
      </div>
    </div></div>
  </section>
  <section class="landing-section course-overview" id="curriculum">
    <div class="section-heading section-heading--center"><div class="course-pill"><BookOpen size={14} /><span>Practical learning</span></div>
      <h2>Make everyday work easier</h2>
      <span>Learn with Tencent WorkBuddy, real practice files, and results you can check.</span>
    </div>
    <div class="course-overview__grid"><article class="course-overview__item"><span>01</span><h3>Documents & receipts</h3><p>Fill templates and extract receipt information with sources ready for review.</p></article><article class="course-overview__item"><span>02</span><h3>Spreadsheets & analysis</h3><p>Clean tables, calculate payroll, and turn data into clear reports.</p></article><article class="course-overview__item"><span>03</span><h3>Communication & workflows</h3><p>Organize customer information and follow-ups, then reuse what works.</p></article></div>
    <div class="course-overview__foot"><span>23 lessons · Practice files, handouts & prompts</span><a href={curriculumNoteUrl}>Full curriculum & notes ↗</a></div>
  </section>
  <section class="landing-section course-enrollment" id="pricing">
    <div class="course-enrollment__copy"><p class="hero-kicker">Learn by doing</p><h2>Your first practical AI course</h2><p>For individuals and teams. Follow the videos and practice with the companion files.</p><a href="/en/courses">Explore more courses →</a></div>
    <CourseCard course={courseCatalog[0]} english={true} />
  </section>

  <!-- Section 7: About Hooosberg & Social Links -->
  <section class="author-section" id="about" style="margin-top: 80px;">
    <div class="author-card">
      <div class="author-mark">
        <img src="/brand/hooosberg-ai-icon.png" alt="" />
      </div>
      <div>
        <p class="hero-kicker">About Hooosberg</p>
        <h2>An indie builder working between art, architecture, products, and AI.</h2>
        <div class="author-card__copy">
          <p>
            I studied architecture in an art academy, have worked with 3D printing and outdoor video,
            and now build AI tools, iOS/macOS apps, and product experiments as a long-term independent system.
          </p>
          <p>
            The site records product pages, launch assets, development diaries, AI conversations, and postmortems.
            The goal is to make the process useful to other builders, not only to show polished results.
          </p>
        </div>
      </div>
    </div>

    <div class="social-card-grid">
      {socialCards.map((link) => (
        <a class="social-card" href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
          <img class="social-card__icon" src={link.icon} alt="" loading="lazy" decoding="async" />
          <span>{link.label}</span>
          <strong>{link.value}</strong>
          {link.url.startsWith("http") && <ExternalLink class="social-card__external" size={14} aria-hidden="true" />}
        </a>
      ))}
    </div>
    <StudioAbout />
  </section>
</BaseLayout>
