---
import { ArrowRight, UserRoundCog, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildSectionWebPageJsonLd } from "../../../utils/structuredData";

const services = [
  {
    title: "WorkBuddy Expert Customization",
    description: "A tailored WorkBuddy setup, task workflow, and expert collaboration approach built around your goals and working style.",
    price: "RMB 1,500",
    note: "One-to-one discovery and an actionable custom plan",
    icon: UserRoundCog,
  },
  {
    title: "WorkBuddy Skill Customization",
    description: "Custom WorkBuddy skills for a specific task, turning repeat work into a reliable and reusable workflow.",
    price: "RMB 1,500",
    note: "Skills and operating guidance tailored to your use case",
    icon: Wrench,
  },
];
const pageDescription = "WorkBuddy expert customization and skill customization services from Hooosberg.";
const jsonLd = buildSectionWebPageJsonLd({
  locale: "en",
  path: "/en/services",
  name: "Hooosberg WorkBuddy Custom Services",
  description: pageDescription,
  topics: ["WorkBuddy custom service", "WorkBuddy expert customization", "WorkBuddy skill customization"],
});
---

<BaseLayout
  locale="en"
  title="Custom Services | Hooosberg"
  description={pageDescription}
  canonicalPath="/en/services"
  jsonLd={jsonLd}
>
  <section class="page-hero page-hero--narrow courses-hero commerce-hero">
    <h1>Custom Services</h1>
    <p>
      WorkBuddy expert customization and skill customization, built around the way you actually work.
    </p>
  </section>

  <section class="catalog-section commerce-section service-section">
    <div class="section-line-heading course-section-heading commerce-section-heading">
      <h2>Custom Services</h2>
      <span>RMB 1,500</span>
    </div>

    <div class="service-grid commerce-card-grid">
      {services.map((service) => {
        const Icon = service.icon;

        return (
          <article class="service-card commerce-card">
            <div class="commerce-card__top">
              <div class="course-icon"><Icon size={20} aria-hidden="true" /></div>
              <span>WorkBuddy custom</span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="service-card__footer commerce-card__footer">
              <div>
                <strong>{service.price}</strong>
                <small>{service.note}</small>
              </div>
              <a class="commerce-action" href="/en/links">
                Contact
                <ArrowRight size={15} aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
