---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Hooosberg"
  description="The page you requested does not exist or has moved."
  canonicalPath="/en/404"
  noindex={true}
>
  <section class="not-found-page">
    <p>404</p>
    <h1>This page was not found.</h1>
    <span>It may have moved, been renamed, or the link may be incorrect.</span>
    <div>
      <a class="button button--primary" href="/en">Back to home</a>
      <a class="button button--secondary" href="/en/ai-navigation">Browse the AI guide</a>
    </div>
  </section>
</BaseLayout>
