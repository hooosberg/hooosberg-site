---
import { ExternalLink } from "@lucide/astro";
import CopyableCodeBlock from "../../../components/CopyableCodeBlock.astro";
import ArticleDownloadResources from "../../../components/ArticleDownloadResources.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articles, type Article } from "../../../data/articles";
import { products } from "../../../data/products";
import { absoluteUrl, getLocalizedArticle, getLocalizedProduct } from "../../../utils/i18n";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { sourceArticle: article },
  }));
}

type Props = { sourceArticle: Article };

const { sourceArticle } = Astro.props;
const article = getLocalizedArticle(sourceArticle, "en");
const relatedProducts = article.productSlugs
  .map((slug) => products.find((product) => product.slug === slug))
  .filter(Boolean)
  .map((product) => product && getLocalizedProduct(product, "en"));
const relatedArticles = (sourceArticle.relatedArticleSlugs ?? [])
  .map((slug) => articles.find((item) => item.slug === slug))
  .filter((item): item is Article => Boolean(item))
  .map((item) => getLocalizedArticle(item, "en"));
const diaryReturnHref = `/en/blog?kind=${article.diaryKind}`;
const hiddenLeadPrefixes = ["resource url:", "video url:"];
const visibleBody = article.body.filter(
  (paragraph) => !hiddenLeadPrefixes.some((prefix) => paragraph.trim().toLowerCase().startsWith(prefix)),
);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.excerpt,
  datePublished: article.date,
  dateModified: article.date,
  url: absoluteUrl(`/en/blog/${article.slug}`),
  inLanguage: "en",
  keywords: article.tags.join(", "),
  author: {
    "@type": "Person",
    name: "Hooosberg",
    url: absoluteUrl("/en"),
  },
  publisher: {
    "@type": "Organization",
    name: "Hooosberg",
    url: absoluteUrl("/en"),
    logo: {
      "@type": "ImageObject",
      url: absoluteUrl("/brand/hooosberg-ai-icon.png"),
    },
  },
  mainEntityOfPage: absoluteUrl(`/en/blog/${article.slug}`),
};
---

<BaseLayout
  locale="en"
  title={`${article.title} | Hooosberg`}
  description={article.excerpt}
  canonicalPath={`/en/blog/${article.slug}`}
  type="article"
  publishedTime={article.date}
  modifiedTime={article.date}
  jsonLd={articleJsonLd}
>
  <article class="article-detail" data-diary-kind={article.diaryKind}>
    <header>
      <a class="article-back-link" href={diaryReturnHref}>Back to Notes</a>
      <p>{article.category} / {article.date}</p>
      <h1>{article.title}</h1>
      <div class="tag-row">
        {article.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>

    {(article.videoUrl || article.videoMeta) && (
      <aside class="article-video-card" aria-label="Video link">
        <div>
          <span>Video link</span>
          <strong>{article.videoMeta ?? "Video tutorial"}</strong>
          <p>Each video note starts with the lesson link, then organizes slides, prompts, and workflow steps.</p>
        </div>
        {article.videoUrl ? (
          <a class="button article-resource-link" href={article.videoUrl} target="_blank" rel="noreferrer">
            Open video
            <ExternalLink size={16} aria-hidden="true" />
          </a>
        ) : (
          <span class="button button--disabled article-resource-link" aria-disabled="true">Pending upload</span>
        )}
      </aside>
    )}

    {(article.slug.startsWith("video-cola-") || article.tags?.includes("Cola")) && (
      <aside class="article-benefit-card" aria-label="Course practice environment and student perk">
        <div class="article-benefit-card__header">
          <span class="article-benefit-card__icon" aria-hidden="true">🎁</span>
          <div>
            <strong>Recommended Practice Environment & Student Perk</strong>
            <p>This hands-on series uses Cola AI workstation. Experience top global models (built-in ChatGPT, Claude Code) with full Alipay payment support.</p>
          </div>
        </div>
        <div class="article-benefit-card__inner">
          <p class="article-benefit-card__text">
            Visit <strong><a href="https://colaos.ai/" target="_blank" rel="noreferrer">colaos.ai</a></strong> and enter student referral code <code>HU-U7DSEXZJ</code> to claim <strong>3-day VIP access</strong>, with Ox models free for a limited time.
          </p>
          <div class="article-benefit-card__actions">
            <a class="button button--primary article-benefit-card__btn" href="https://colaos.ai/" target="_blank" rel="noreferrer">
              Try colaos.ai ↗
            </a>
            <span class="article-benefit-card__code">
              Code: <strong>HU-U7DSEXZJ</strong>
            </span>
          </div>
        </div>
      </aside>
    )}

    <div class="article-body">
      {article.contentHtml ? (
        <Fragment set:html={article.contentHtml} />
      ) : (
        <>
          {visibleBody.map((paragraph) => {
            if (paragraph.includes("课程概要与课件下载说明") || paragraph.includes("Course Outline & Download Notice")) {
              return (
                <div class="article-course-notice" style="margin: 20px 0 28px; padding: 18px 22px; border-radius: 14px; background: color-mix(in srgb, #10b981 8%, var(--surface-solid)); border: 1.5px solid color-mix(in srgb, #10b981 35%, var(--border)); display: flex; flex-direction: column; gap: 10px;">
                  <div style="display: flex; align-items: center; gap: 8px; font-weight: 800; color: #059669; font-size: 15px;">
                    <span style="font-size: 18px;">📌</span>
                    <span>Course Outline & Practice Assets Notice</span>
                  </div>
                  <p style="margin: 0; font-size: 14px; line-height: 1.65; color: var(--text);">
                    {paragraph.replace(/^【课程概要与课件下载说明】/, "")}
                  </p>
                  <div style="margin-top: 4px;">
                    <a class="button button--primary" style="border-radius: 9999px; padding: 8px 18px; font-size: 13.5px; font-weight: 700; width: fit-content; display: inline-flex; align-items: center; gap: 6px;" href="https://www.bilibili.com/cheese/play/ss402180572?csource=private_space_class_null&spm_id_from=333.1387.0.0" target="_blank" rel="noreferrer">
                      Enroll on Bilibili to download full assets (Promo ¥199) ↗
                    </a>
                  </div>
                </div>
              );
            }
            return <p>{paragraph}</p>;
          })}
          {article.sections?.map((section) => (
            <section class="article-section">
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.codeBlocks?.map((code) => (
                <CopyableCodeBlock code={code} label="Copy prompt" copiedLabel="Copied" />
              ))}
            </section>
          ))}
        </>
      )}
    </div>

    {article.downloadableResources && article.downloadableResources.length > 0 && (
      <ArticleDownloadResources resources={article.downloadableResources} locale="en" />
    )}

    {article.resourceUrl && (
      <div class="article-resource-actions">
        <a class="button article-resource-link" href={article.resourceUrl} target="_blank" rel="noreferrer">
          Open resource
          <ExternalLink size={16} aria-hidden="true" />
        </a>
      </div>
    )}

    {relatedProducts.length > 0 && (
      <footer class="article-related">
        <h2>Related Products</h2>
        <div class="mini-link-row">
          {relatedProducts.map((product) => product && <a href={`/en/apps/${product.slug}`}>{product.displayName}</a>)}
        </div>
      </footer>
    )}

    {relatedArticles.length > 0 && (
      <footer class="article-related">
        <h2>Related Lessons</h2>
        <div class="mini-link-row">
          {relatedArticles.map((item) => <a href={`/en/blog/${item.slug}`}>{item.title}</a>)}
        </div>
      </footer>
    )}
  </article>
</BaseLayout>
