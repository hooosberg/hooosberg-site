---
import { ArrowUpRight, BookOpen, ExternalLink, Lightbulb, Wrench } from "@lucide/astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articlesByDate, diarySections, videoTutorialNoteArticles } from "../../../data/articles";
import { learningSeries } from "../../../data/learningSeries";
import { getLocalizedArticle } from "../../../utils/i18n";
import { buildItemListJsonLd, buildSectionCollectionJsonLd } from "../../../utils/structuredData";

const articlesPerPage = 15;
const workbuddy = learningSeries.find((series) => series.id === "workbuddy")!;
const cola = learningSeries.find((series) => series.id === "cola")!;
const localizedArticles = articlesByDate.map((article) => getLocalizedArticle(article, "en"));
const otherGroups = diarySections.filter((section) => section.kind !== "video").map((section) => ({
  ...section,
  articles: localizedArticles.filter((article) => article.diaryKind === section.kind),
}));
const courseArticles = new Map(videoTutorialNoteArticles.map((article) => {
  const localized = getLocalizedArticle(article, "en");
  return [article.slug, localized] as const;
}));
const courseCopy = {
  workbuddy: {
    title: "AI Office Automation: Beginner Green Book",
    toolLine: "Works with WorkBuddy, Doubao Work, Qwen Work, and more · 30 free lessons",
    description: "Start with your first AI task, then learn the foundations of files, spreadsheets, documents, workflows, browsers, and local folders.",
  },
  cola: {
    title: "AI Office Automation: Practice Green Book",
    toolLine: "Cola / Codex / Claude Code · problem-led practice",
    description: "Use real office problems to organize source files, rules, prompts, checks, and final deliverables into a complete workflow.",
  },
};
const pageDescription = "Two free AI office automation learning paths: a WorkBuddy beginner course and a Cola, Codex, and Claude Code practice series, plus product, reading, thought, and resource notes.";
const jsonLd = [
  buildSectionCollectionJsonLd({ locale: "en", path: "/en/blog", name: "Hooosberg AI Office Automation Green Books", description: pageDescription, topics: ["AI automation", "WorkBuddy", "Cola", "Codex", "Claude Code"] }),
  buildItemListJsonLd("https://hooosberg.com/en/blog#learning-notes", localizedArticles.filter((article) => article.diaryKind === "video").map((article) => ({ name: article.title, url: `/en/blog/${article.slug}`, description: article.excerpt }))),
];
---

<BaseLayout locale="en" title="Learning Notes | Hooosberg" description={pageDescription} canonicalPath="/en/blog" jsonLd={jsonLd}>
  <section class="page-hero page-hero--narrow learning-hero">
    <h1>Learning Notes</h1>
    <p>Learn AI office automation by doing it. Choose a free learning path, then return to the video, handout, and downloadable resources for each lesson.</p>
  </section>

  <section class="learning-index" aria-label="Learning notes sections">
    <div class="learning-switch" role="tablist" aria-label="Learning paths">
      <button class="learning-tab" type="button" role="tab" aria-selected="true" data-learning-tab="workbuddy">Beginner Green Book</button>
      <button class="learning-tab" type="button" role="tab" aria-selected="false" data-learning-tab="cola">Practice Green Book</button>
      <button class="learning-tab" type="button" role="tab" aria-selected="false" data-learning-tab="other">Other Notes</button>
    </div>

    <section class="learning-panel" data-learning-panel="workbuddy">
      <div class="series-intro">
        <div class="series-book series-book--beginner" aria-hidden="true"><BookOpen size={34} /></div>
        <div><h2>{courseCopy.workbuddy.title}</h2><p class="series-tool-line">{courseCopy.workbuddy.toolLine}</p><p>{courseCopy.workbuddy.description}</p></div>
        <a class="button button--primary series-playlist" href={workbuddy.playlistUrl} target="_blank" rel="noreferrer">Open Bilibili series <ExternalLink size={16} aria-hidden="true" /></a>
      </div>
      <div class="learning-list-header"><div><p>30-lesson Bilibili series · {workbuddy.lessons.length} notes published</p><h3>Notes and resources by lesson</h3></div><span>Lessons marked “Download” include a public Markdown resource.</span></div>
      <div class="learning-lesson-list">
        {[...workbuddy.lessons].reverse().map((lesson) => {
          const article = lesson.articleSlug ? courseArticles.get(lesson.articleSlug) : undefined;
          const href = article ? `/en/blog/${article.slug}?kind=video` : workbuddy.playlistUrl;
          return <a class="learning-lesson-row" href={href} target={article ? undefined : "_blank"} rel={article ? undefined : "noreferrer"}>
            <span class="learning-lesson-number">{String(lesson.number).padStart(2, "0")}</span>
            <span class="learning-lesson-copy"><strong>{article?.title ?? lesson.title}</strong><small>{article?.excerpt ?? lesson.outcome}</small></span>
            {lesson.hasDownload && <span class="learning-download-flag">Download</span>}
            <ArrowUpRight size={17} aria-hidden="true" />
          </a>;
        })}
      </div>
    </section>

    <section class="learning-panel" data-learning-panel="cola" hidden>
      <div class="series-intro">
        <div class="series-book series-book--practice" aria-hidden="true"><Wrench size={32} /></div>
        <div><h2>{courseCopy.cola.title}</h2><p class="series-tool-line">{courseCopy.cola.toolLine}</p><p>{courseCopy.cola.description}</p></div>
        <a class="button button--primary series-playlist" href={cola.playlistUrl} target="_blank" rel="noreferrer">Open Bilibili series <ExternalLink size={16} aria-hidden="true" /></a>
      </div>
      <div class="series-sync-note"><Lightbulb size={20} aria-hidden="true" /><p>Only lessons 1–4 are published here. Their notes follow the local Word student handouts; later lessons are added only after the corresponding video is uploaded.</p></div>
      <div class="learning-list-header"><div><p>4 published lessons · handouts synchronized</p><h3>Practice notes and copyable prompts</h3></div><span>Each note keeps the Bilibili practice-series link at the top.</span></div>
      <div class="learning-lesson-list">
        {[...cola.lessons].reverse().map((lesson) => {
          const article = lesson.articleSlug ? courseArticles.get(lesson.articleSlug) : undefined;
          const href = article ? `/en/blog/${article.slug}?kind=video` : cola.playlistUrl;
          return <a class="learning-lesson-row" href={href} target={article ? undefined : "_blank"} rel={article ? undefined : "noreferrer"}>
            <span class="learning-lesson-number">{String(lesson.number).padStart(2, "0")}</span>
            <span class="learning-lesson-copy"><strong>{article?.title ?? lesson.title}</strong><small>{article?.excerpt ?? lesson.outcome}</small></span>
            <ArrowUpRight size={17} aria-hidden="true" />
          </a>;
        })}
      </div>
    </section>

    <section class="learning-panel" data-learning-panel="other" hidden>
      <div class="other-notes-heading"><div><h2>Other Notes</h2><p>Product development, reading, thoughts, and resources live here in one place.</p></div></div>
      <div class="other-note-switch" role="tablist" aria-label="Other note types">
        {otherGroups.map((group, index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-other-tab={group.kind}>{group.label}<small>{group.articles.length} notes</small></button>)}
      </div>
      <div class="article-list article-list--other">
        {otherGroups.flatMap((group, groupIndex) => group.articles.map((article, articleIndex) => <a class="article-row" href={`/en/blog/${article.slug}?kind=${group.kind}`} data-other-row={group.kind} data-other-page={Math.floor(articleIndex / articlesPerPage) + 1} hidden={groupIndex !== 0 || articleIndex >= articlesPerPage}>
          <span class="article-row__category">{article.productLabel ?? article.category}</span><span class="article-row__title">{article.title}</span><span class="article-row__excerpt">{article.excerpt}</span><span class="article-row__date">{article.date}</span>
        </a>))}
      </div>
      {otherGroups.map((group, groupIndex) => {
        const pageCount = Math.ceil(group.articles.length / articlesPerPage);
        return <nav class="diary-pagination" aria-label={`${group.label} pagination`} data-other-pagination={group.kind} hidden={groupIndex !== 0 || pageCount <= 1}>
          {Array.from({ length: pageCount }, (_, pageIndex) => <button class="diary-page-button" type="button" data-other-page-button data-other-kind={group.kind} data-other-page={pageIndex + 1} aria-current={pageIndex === 0 ? "page" : undefined}>{pageIndex + 1}</button>)}
        </nav>;
      })}
    </section>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const panels = Array.from(document.querySelectorAll("[data-learning-panel]")); const tabs = Array.from(document.querySelectorAll("[data-learning-tab]"));
    const otherTabs = Array.from(document.querySelectorAll("[data-other-tab]")); const otherRows = Array.from(document.querySelectorAll("[data-other-row]"));
    const otherPaginations = Array.from(document.querySelectorAll("[data-other-pagination]")); const otherPageButtons = Array.from(document.querySelectorAll("[data-other-page-button]"));
    const setPanel = (name) => { panels.forEach((panel) => { panel.hidden = panel.dataset.learningPanel !== name; }); tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.learningTab === name))); const url = new URL(window.location.href); url.searchParams.set("section", name); window.history.replaceState({}, "", `${url.pathname}${url.search}`); };
    const setOther = (kind, page = 1) => { otherTabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.otherTab === kind))); otherRows.forEach((row) => { row.hidden = row.dataset.otherRow !== kind || Number(row.dataset.otherPage || "1") !== page; }); otherPaginations.forEach((nav) => { nav.hidden = nav.dataset.otherPagination !== kind || nav.querySelectorAll("button").length < 2; }); otherPageButtons.forEach((button) => button.setAttribute("aria-current", String(button.dataset.otherKind === kind && Number(button.dataset.otherPage) === page))); };
    tabs.forEach((tab) => tab.addEventListener("click", () => setPanel(tab.dataset.learningTab))); otherTabs.forEach((tab) => tab.addEventListener("click", () => setOther(tab.dataset.otherTab, 1))); otherPageButtons.forEach((button) => button.addEventListener("click", () => setOther(button.dataset.otherKind, Number(button.dataset.otherPage))));
    const initial = new URLSearchParams(window.location.search).get("section"); if (initial && tabs.some((tab) => tab.dataset.learningTab === initial)) setPanel(initial); setOther(otherTabs[0]?.dataset.otherTab, 1);
  })();
</script>
