---
import { ExternalLink } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { socialLinks } from "../../data/products";
import { buildSectionWebPageJsonLd } from "../../utils/structuredData";

const linkCards = socialLinks.map((link) => ({
  ...link,
  note: "note" in link ? link.note : "邮件直达",
  displayNote: "note" in link ? link.note : "邮件直达",
}));

const videoLabels = ["YouTube", "B站", "抖音", "快手", "TikTok"];
const socialLabels = ["GitHub", "X", "小红书"];
const directLabels = ["Email", "Telegram"];

const getCards = (labels: string[]) =>
  labels.map((label) => linkCards.find((link) => link.label === label)).filter(Boolean);

const contactSections = [
  {
    title: "邮箱、电报和 QQ 群",
    kicker: "课程、产品、合作和技术交流，可以通过邮箱、电报或 QQ 群联系。",
    cards: getCards(directLabels),
    className: "platform-card-grid--direct",
  },
  {
    title: "视频账号",
    kicker: "教程、产品演示、AI 工作流和真实开发过程。",
    cards: getCards(videoLabels),
    className: "platform-card-grid--video",
  },
  {
    title: "社交媒体",
    kicker: "日常想法、项目更新、源码和图文记录。",
    cards: getCards(socialLabels),
    className: "platform-card-grid--social",
  },
];
const pageDescription = "湖森堡AI_hooosberg 视频账号、社交媒体、邮箱、电报、QQ 群及产品测评合作联系方式。";
const jsonLd = buildSectionWebPageJsonLd({
  locale: "zh-CN",
  path: "/links",
  name: "湖森堡官方联系方式",
  description: pageDescription,
  topics: ["Hooosberg official links", "Hooosberg contact", "social profiles", "official support"],
});
---

<BaseLayout title="联系 | 湖森堡AI_hooosberg" description={pageDescription} jsonLd={jsonLd}>
  <section class="page-hero page-hero--narrow">
    <p class="commerce-kicker">Contact</p>
    <h1>联系</h1>
    <p>这里整理了我们的视频账号、社交媒体、邮箱、电报和 QQ 群。想看过程、跟进产品、交流合作，或有产品想做视频测评和推广，都可以把链接和简介发到邮箱；内容适合的话，我会再联系沟通。</p>
  </section>

  <section class="link-hub">
    {contactSections.map((section) => (
      <div class="contact-platform-section">
        <div class="contact-platform-section__heading">
          <span>{section.title}</span>
          <p>{section.kicker}</p>
        </div>
        {section.className === "platform-card-grid--direct" && (
          <div class="qq-group-block" id="qq-group">
            <img
              class="qq-group-block__image"
              src="/images/contact/qq-group-1105424769.jpg"
              alt="湖森堡 QQ 群二维码，群号 1105424769"
              loading="eager"
              decoding="async"
            />
            <div class="qq-group-block__content">
              <span>QQ 群</span>
              <strong>加入湖森堡 QQ 群</strong>
              <p>扫描二维码加入群聊，也可搜索群号 1105424769。</p>
            </div>
          </div>
        )}
        <div class={`platform-card-grid ${section.className}`}>
          {section.cards.map((link) => (
            <a
              class="platform-card"
              href={link.url}
              target={link.url.startsWith("http") ? "_blank" : undefined}
              rel="noreferrer"
              aria-label={`${link.label}：${link.displayNote}`}
            >
              <img class="platform-card__icon" src={link.icon} alt="" loading="lazy" decoding="async" />
              <strong>{link.displayNote}</strong>
              {link.url.startsWith("http") && <ExternalLink class="platform-card__external" size={16} aria-hidden="true" />}
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
