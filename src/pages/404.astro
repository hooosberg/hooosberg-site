---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="页面未找到｜湖森堡AI_hooosberg"
  description="你访问的页面不存在或已移动。"
  canonicalPath="/404"
  noindex={true}
>
  <section class="not-found-page">
    <p>404</p>
    <h1>这个页面没有找到。</h1>
    <span>它可能已移动、改名，或者链接地址有误。</span>
    <div>
      <a class="button button--primary" href="/">返回首页</a>
      <a class="button button--secondary" href="/ai-navigation">浏览 AI 工具导航</a>
    </div>
  </section>
</BaseLayout>
