---
import { ArrowRight, BookOpen, ExternalLink } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import StudioAbout from "../components/StudioAbout.astro";
import { socialLinks } from "../data/products";
import { buildHomeJsonLd } from "../utils/structuredData";

import CourseCard from "../components/CourseCard.astro";
import { courseCatalog } from "../data/courseCatalog";

const bilibiliCourseUrl =
  "https://www.bilibili.com/cheese/play/ss402180572?csource=private_space_class_null&spm_id_from=333.1387.0.0";
const curriculumNoteUrl = "/blog?section=paid";

const socialCards = socialLinks
  .filter((link) => link.label !== "Email")
  .map((link) => ({
    label: link.label,
    value: "note" in link ? link.note : "平台入口",
    url: link.url,
    icon: link.icon,
  }));

---

<BaseLayout
  title="湖森堡AI_hooosberg | AI办公新手入门课程"
  description="企业AI改造先改人再改系统。面向办公新手的 AI 智能体通识与真实业务实战课程，不学编程、不背工具、先跑通工作流，送 23 套随课素材包。"
  jsonLd={buildHomeJsonLd("zh-CN")}
>
  <section class="landing-hero landing-hero--course">
    <div class="hero-grid course-hero__grid" aria-hidden="true"></div>
    <div class="course-hero"><div class="course-hero__copy">
      <h1>AI办公新手入门课</h1><p class="course-hero__lead">不用学编程，也不用追着模型跑。</p><p class="course-hero__choice">从你手上的工作开始，把 AI 用进日常办公。</p>
      <div class="hero-actions course-hero__actions">
        <a class="button button--primary button--xl" href={bilibiliCourseUrl} target="_blank" rel="noreferrer">开始系统学习<ArrowRight size={17} /></a>
        <a class="button button--secondary" href="/courses">其他课程<ArrowRight size={15} /></a>
      </div>
    </div></div>
  </section>
  <section class="landing-section course-overview" id="curriculum">
    <div class="section-heading section-heading--center"><div class="course-pill"><BookOpen size={14} /><span>核心课程内容</span></div>
      <h2>让日常工作，轻松一点</h2>
      <span>以腾讯 WorkBuddy 为主讲环境，跟着真实业务素材实操，做出能检查、能交付的结果。</span>
    </div>
    <div class="course-overview__grid"><article class="course-overview__item"><span>01</span><h3>文档与单据</h3><p>原样填报合同、提取发票信息，保留来源方便复核。</p></article><article class="course-overview__item"><span>02</span><h3>表格与分析</h3><p>清洗合并乱表、核算工资，把数据整理成清楚的汇报。</p></article><article class="course-overview__item"><span>03</span><h3>沟通与流程</h3><p>整理客户信息和待办，把常用方法留下来、反复使用。</p></article></div>
    <div class="course-overview__foot"><span>23 节实操课 · 配套素材、讲义与提示词</span><a href={curriculumNoteUrl}>查看完整目录与学习笔记 ↗</a></div>
  </section>
  <section class="landing-section course-enrollment" id="pricing">
    <div class="course-enrollment__copy"><p class="hero-kicker">从第一件小事开始</p><h2>你的第一门 AI 办公实操课</h2><p>适合个人学习，也适合团队一起入门。跟着视频做，用配套素材练，把方法用回自己的工作。</p><a href="/courses">看看更多课程 →</a></div>
    <CourseCard course={courseCatalog[0]} english={false} />
  </section>

  <!-- Section 7: 关于湖森堡AI_hooosberg 与全网社交媒体矩阵 (用户明确要求完整保留) -->
  <section class="author-section" id="about" style="margin-top: 80px;">
    <div class="author-card">
      <div class="author-mark">
        <img src="/brand/hooosberg-ai-icon.png" alt="" />
      </div>
      <div>
        <p class="hero-kicker">关于湖森堡AI_hooosberg</p>
        <h2>一个在艺术、建筑和技术之间做产品的独立开发者。</h2>
        <div class="author-card__copy">
          <p>
            我毕业于美术学院，本身学的是建筑设计，也长期喜欢研究技术和编程。过去做过 3D 打印，拍过户外纪录片，
            也一直在把空间、影像、工具和产品开发放在同一个系统里思考。
          </p>
          <p>
            现在我正在 all in AI。2026 上半年已经开发并发布了十多个产品，目标是今年完成 20 个，慢慢形成稳定的海外收入。
            这是我的梦想，这个网站会记录路上的产品、课程、核心文件、AI 对话和复盘，也希望把这场历险一路分享给你。
          </p>
        </div>
      </div>
    </div>

    <div class="social-card-grid">
      {socialCards.map((link) => (
        <a class="social-card" href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
          <img class="social-card__icon" src={link.icon} alt="" loading="lazy" decoding="async" />
          <span>{link.label}</span>
          <strong>{link.value}</strong>
          {link.url.startsWith("http") && <ExternalLink class="social-card__external" size={14} aria-hidden="true" />}
        </a>
      ))}
    </div>
    <StudioAbout />
  </section>
</BaseLayout>
