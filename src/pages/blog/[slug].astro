---
import { ExternalLink } from "@lucide/astro";
import CopyableCodeBlock from "../../components/CopyableCodeBlock.astro";
import ArticleDownloadResources from "../../components/ArticleDownloadResources.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles, type Article } from "../../data/articles";
import { products } from "../../data/products";
import { absoluteUrl } from "../../utils/i18n";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

type Props = { article: Article };

const { article } = Astro.props;
const hiddenLeadPrefixes = ["资源链接：", "视频入口："];
const visibleBody = article.body.filter(
  (paragraph) => !hiddenLeadPrefixes.some((prefix) => paragraph.trim().startsWith(prefix)),
);
const relatedProducts = article.productSlugs
  .map((slug) => products.find((product) => product.slug === slug))
  .filter(Boolean);
const relatedArticles = (article.relatedArticleSlugs ?? [])
  .map((slug) => articles.find((item) => item.slug === slug))
  .filter((item): item is Article => Boolean(item));
const diaryReturnHref = `/blog?kind=${article.diaryKind}`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.excerpt,
  datePublished: article.date,
  dateModified: article.date,
  url: absoluteUrl(`/blog/${article.slug}`),
  inLanguage: "zh-CN",
  keywords: article.tags.join(", "),
  author: {
    "@type": "Person",
    name: "Hooosberg",
    url: absoluteUrl("/"),
  },
  publisher: {
    "@type": "Organization",
    name: "湖森堡AI_hooosberg",
    url: absoluteUrl("/"),
    logo: {
      "@type": "ImageObject",
      url: absoluteUrl("/brand/hooosberg-ai-icon.png"),
    },
  },
  mainEntityOfPage: absoluteUrl(`/blog/${article.slug}`),
};
---

<BaseLayout
  title={`${article.title} | 湖森堡AI_hooosberg`}
  description={article.excerpt}
  canonicalPath={`/blog/${article.slug}`}
  type="article"
  publishedTime={article.date}
  modifiedTime={article.date}
  jsonLd={articleJsonLd}
>
  <article class="article-detail" data-diary-kind={article.diaryKind}>
    <header>
      <a class="article-back-link" href={diaryReturnHref}>返回笔记</a>
      <p>{article.category} / {article.date}</p>
      <h1>{article.title}</h1>
      <div class="tag-row">
        {article.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>

    {(article.videoUrl || article.videoMeta) && (
      <aside class="article-video-card" aria-label="视频入口">
        <div>
          <span>视频入口</span>
          <strong>{article.videoMeta ?? "视频教程"}</strong>
          <p>每篇视频教程笔记都会先放视频链接，再整理课件、提示词和操作流程。</p>
        </div>
        {article.videoUrl ? (
          <a class="button article-resource-link" href={article.videoUrl} target="_blank" rel="noreferrer">
            打开视频
            <ExternalLink size={16} aria-hidden="true" />
          </a>
        ) : (
          <span class="button button--disabled article-resource-link" aria-disabled="true">待上传</span>
        )}
      </aside>
    )}

    {(article.slug.startsWith("video-cola-") || article.tags?.includes("Cola")) && (
      <aside class="article-benefit-card" aria-label="课程实操环境与学员福利">
        <div class="article-benefit-card__header">
          <span class="article-benefit-card__icon" aria-hidden="true">🎁</span>
          <div>
            <strong>实操环境推荐与学员专属福利</strong>
            <p>本系列实战课基于 Cola 智能体工作台演示。内置 ChatGPT、Claude Code 等海外顶尖模型，国内支持支付宝直接使用。</p>
          </div>
        </div>
        <div class="article-benefit-card__inner">
          <p class="article-benefit-card__text">
            访问官方体验入口 <a href="https://colaos.ai/" target="_blank" rel="noreferrer">colaos.ai</a>，填写推荐码 <code>HU-U7DSEXZJ</code> 可领取 <strong>3 天会员体验</strong>，Ox 模型限时免费。
          </p>
          <div class="article-benefit-card__actions">
            <a class="button button--primary article-benefit-card__btn" href="https://colaos.ai/" target="_blank" rel="noreferrer">
              访问 colaos.ai 体验 ↗
            </a>
            <span class="article-benefit-card__code">
              推荐码：<strong>HU-U7DSEXZJ</strong>
            </span>
          </div>
        </div>
      </aside>
    )}

    <div class="article-body">
      {article.contentHtml ? (
        <Fragment set:html={article.contentHtml} />
      ) : (
        <>
          {visibleBody.map((paragraph) => {
            if (paragraph.startsWith("【课程概要与课件下载说明】")) {
              return (
                <div class="article-course-notice" style="margin: 20px 0 28px; padding: 18px 22px; border-radius: 14px; background: color-mix(in srgb, #10b981 8%, var(--surface-solid)); border: 1.5px solid color-mix(in srgb, #10b981 35%, var(--border)); display: flex; flex-direction: column; gap: 10px;">
                  <div style="display: flex; align-items: center; gap: 8px; font-weight: 800; color: #059669; font-size: 15px;">
                    <span style="font-size: 18px;">📌</span>
                    <span>课程概要与课件下载说明</span>
                  </div>
                  <p style="margin: 0; font-size: 14px; line-height: 1.65; color: var(--text);">
                    {paragraph.replace(/^【课程概要与课件下载说明】/, "")}
                  </p>
                  <div style="margin-top: 4px;">
                    <a class="button button--primary" style="border-radius: 9999px; padding: 8px 18px; font-size: 13.5px; font-weight: 700; width: fit-content; display: inline-flex; align-items: center; gap: 6px;" href="https://www.bilibili.com/cheese/play/ss402180572?csource=private_space_class_null&spm_id_from=333.1387.0.0" target="_blank" rel="noreferrer">
                      前往 B 站购买课程下载完整资料 (特惠 ¥199) ↗
                    </a>
                  </div>
                </div>
              );
            }
            return <p>{paragraph}</p>;
          })}
          {article.sections?.map((section) => (
            <section class="article-section">
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.codeBlocks?.map((code) => (
                <CopyableCodeBlock code={code} label="复制提示词" copiedLabel="已复制" />
              ))}
            </section>
          ))}
        </>
      )}
    </div>

    {article.downloadableResources && article.downloadableResources.length > 0 && (
      <ArticleDownloadResources resources={article.downloadableResources} />
    )}

    {article.resourceUrl && (
      <div class="article-resource-actions">
        <a class="button article-resource-link" href={article.resourceUrl} target="_blank" rel="noreferrer">
          打开资源
          <ExternalLink size={16} aria-hidden="true" />
        </a>
      </div>
    )}

    {relatedProducts.length > 0 && (
      <footer class="article-related">
        <h2>关联产品</h2>
        <div class="mini-link-row">
          {relatedProducts.map((product) => product && <a href={`/apps/${product.slug}`}>{product.displayName}</a>)}
        </div>
      </footer>
    )}

    {relatedArticles.length > 0 && (
      <footer class="article-related">
        <h2>关联课程</h2>
        <div class="mini-link-row">
          {relatedArticles.map((item) => <a href={`/blog/${item.slug}`}>{item.title}</a>)}
        </div>
      </footer>
    )}
  </article>
</BaseLayout>
