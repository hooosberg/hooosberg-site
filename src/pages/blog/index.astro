---
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articlesByDate, diarySections, videoTutorialNoteArticles } from "../../data/articles";
import { learningSeries } from "../../data/learningSeries";
import { buildItemListJsonLd, buildSectionCollectionJsonLd } from "../../utils/structuredData";

const articlesPerPage = 15;
const workbuddy = learningSeries.find((series) => series.id === "workbuddy")!;
const cola = learningSeries.find((series) => series.id === "cola")!;
const otherGroups = diarySections.filter((section) => section.kind !== "video").map((section) => ({
  ...section,
  articles: articlesByDate.filter((article) => article.diaryKind === section.kind),
}));
const courseArticles = new Map(videoTutorialNoteArticles.map((article) => [article.slug, article]));
const pageDescription = "WorkBuddy 办公教程与 Codex 编程教程合集；另收纳产品、阅读、随想和资源笔记。";
const jsonLd = [
  buildSectionCollectionJsonLd({ locale: "zh-CN", path: "/blog", name: "湖森堡 AI 自动化办公绿皮书", description: pageDescription, topics: ["AI automation", "WorkBuddy", "Codex", "AI办公智能体", "Claude Code"] }),
  buildItemListJsonLd("https://hooosberg.com/blog#learning-notes", videoTutorialNoteArticles.map((article) => ({ name: article.title, url: `/blog/${article.slug}`, description: article.excerpt }))),
];
---

<BaseLayout title="WorkBuddy AI办公教程 | 湖森堡AI_hooosberg" description={pageDescription} jsonLd={jsonLd}>
  <section class="page-hero page-hero--narrow learning-hero">
    <h1 id="learning-hero-title">WorkBuddy AI办公教程</h1>
    <p id="learning-hero-subtitle" class="learning-hero-subtitle">涵盖豆包办公、千问办公等国产办公 AI 教程，系统掌握 Excel、PPT、Word 自动化实战。</p>
  </section>

  <section class="learning-index" aria-label="学习笔记分区">
    <div class="learning-switch" role="tablist" aria-label="学习路线">
      <button class="learning-tab" type="button" role="tab" aria-selected="true" data-learning-tab="workbuddy" data-title="WorkBuddy AI办公教程" data-subtitle="涵盖豆包办公、千问办公等国产办公 AI 教程，系统掌握 Excel、PPT、Word 自动化实战。">WorkBuddy AI办公教程</button>
      <button class="learning-tab" type="button" role="tab" aria-selected="false" data-learning-tab="cola" data-title="Codex编程教程" data-subtitle="包含 AI 资讯、Codex、Gemini 与 ChatGPT 等海外 AI 工具编程教程与实战。">Codex编程教程</button>
      <button class="learning-tab" type="button" role="tab" aria-selected="false" data-learning-tab="other" data-title="其他笔记" data-subtitle="收纳真实产品研发、深度阅读、人文随想与精选开发资源笔记。">其他笔记</button>
    </div>

    <section class="learning-panel" data-learning-panel="workbuddy">
      <div class="learning-list-header">
        <div>
          <p>B 站公开系列 · 34 课时完整大纲</p>
          <h3>按课时查看标题、简介与配套笔记资料</h3>
        </div>
        <span>每集均配有可复制提示词与课后验收方法。</span>
      </div>
      <div class="learning-lesson-list">
        {[...workbuddy.lessons].reverse().map((lesson) => {
          const article = lesson.articleSlug ? courseArticles.get(lesson.articleSlug) : undefined;
          const displayName = article ? article.title.replace(/^视频教程笔记 · /, "") : lesson.title;
          const href = article ? `/blog/${article.slug}?kind=video` : (lesson.videoUrl || workbuddy.playlistUrl);
          return <a class="learning-lesson-row" href={href} target={article ? undefined : "_blank"} rel={article ? undefined : "noreferrer"}>
            <span class="learning-lesson-number">{String(lesson.number).padStart(2, "0")}</span>
            <span class="learning-lesson-copy"><strong>{displayName}</strong><small>{lesson.outcome}</small></span>
            {lesson.hasDownload && <span class="learning-download-flag">有下载</span>}
            <ArrowUpRight size={17} aria-hidden="true" />
          </a>;
        })}
      </div>
    </section>

    <section class="learning-panel" data-learning-panel="cola" hidden>
      <div class="learning-list-header">
        <div>
          <p>Codex / ChatGPT 实操与前沿实测系列 · 共 {cola.lessons.length} 课时</p>
          <h3>按实战案例看笔记、提示词与配套视频</h3>
        </div>
        <span>包含 ChatGPT 视觉工作流、前沿模型实测与问题驱动实操，带课件标注。</span>
      </div>
      <div class="learning-lesson-list">
        {cola.lessons.map((lesson) => {
          const article = lesson.articleSlug ? courseArticles.get(lesson.articleSlug) : undefined;
          const displayName = article ? article.title.replace(/^视频教程笔记 · /, "") : lesson.title;
          const href = article ? `/blog/${article.slug}?kind=video` : (lesson.videoUrl || cola.playlistUrl);
          const isPinned = lesson.isPinned;
          return <a class={`learning-lesson-row ${isPinned ? "learning-lesson-row--pinned" : ""}`} href={href} target={article ? undefined : "_blank"} rel={article ? undefined : "noreferrer"}>
            <span class={`learning-lesson-number ${isPinned ? "learning-lesson-number--pinned" : ""}`}>{isPinned ? "置顶" : String(lesson.number).padStart(2, "0")}</span>
            <span class="learning-lesson-copy"><strong>{displayName}</strong><small>{lesson.outcome}</small></span>
            {isPinned && <span class="learning-pinned-flag">置顶精选</span>}
            {lesson.hasDownload && <span class="learning-download-flag">有下载</span>}
            <ArrowUpRight size={17} aria-hidden="true" />
          </a>;
        })}
      </div>
    </section>

    <section class="learning-panel" data-learning-panel="other" hidden>
      <div class="other-notes-heading"><div><h2>其他笔记</h2><p>把产品开发、读书、随想和资源统一收纳在这里。</p></div></div>
      <div class="other-note-switch" role="tablist" aria-label="其他笔记类型">
        {otherGroups.map((group, index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-other-tab={group.kind}>{group.label}<small>{group.articles.length} 篇</small></button>)}
      </div>
      <div class="article-list article-list--other">
        {otherGroups.flatMap((group, groupIndex) => group.articles.map((article, articleIndex) => <a class="article-row" href={`/blog/${article.slug}?kind=${group.kind}`} data-other-row={group.kind} data-other-page={Math.floor(articleIndex / articlesPerPage) + 1} hidden={groupIndex !== 0 || articleIndex >= articlesPerPage}>
          <span class="article-row__category">{article.productLabel ?? article.category}</span><span class="article-row__title">{article.title}</span><span class="article-row__excerpt">{article.excerpt}</span><span class="article-row__date">{article.date}</span>
        </a>))}
      </div>
      {otherGroups.map((group, groupIndex) => {
        const pageCount = Math.ceil(group.articles.length / articlesPerPage);
        return <nav class="diary-pagination" aria-label={`${group.label}分页`} data-other-pagination={group.kind} hidden={groupIndex !== 0 || pageCount <= 1}>
          {Array.from({ length: pageCount }, (_, pageIndex) => <button class="diary-page-button" type="button" data-other-page-button data-other-kind={group.kind} data-other-page={pageIndex + 1} aria-current={pageIndex === 0 ? "page" : undefined}>{pageIndex + 1}</button>)}
        </nav>;
      })}
    </section>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const heroTitle = document.getElementById("learning-hero-title");
    const heroSubtitle = document.getElementById("learning-hero-subtitle");
    const panels = Array.from(document.querySelectorAll("[data-learning-panel]"));
    const tabs = Array.from(document.querySelectorAll("[data-learning-tab]"));
    const otherTabs = Array.from(document.querySelectorAll("[data-other-tab]"));
    const otherRows = Array.from(document.querySelectorAll("[data-other-row]"));
    const otherPaginations = Array.from(document.querySelectorAll("[data-other-pagination]"));
    const otherPageButtons = Array.from(document.querySelectorAll("[data-other-page-button]"));

    const setPanel = (name) => {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.learningPanel !== name;
      });
      tabs.forEach((tab) => {
        const isSelected = tab.dataset.learningTab === name;
        tab.setAttribute("aria-selected", String(isSelected));
        if (isSelected) {
          const tabTitle = tab.dataset.title || tab.textContent.trim();
          if (heroTitle) heroTitle.textContent = tabTitle;
          if (heroSubtitle && tab.dataset.subtitle) heroSubtitle.textContent = tab.dataset.subtitle;
          document.title = `${tabTitle} | 湖森堡AI_hooosberg`;
        }
      });
      const url = new URL(window.location.href);
      url.searchParams.set("section", name);
      window.history.replaceState({}, "", `${url.pathname}${url.search}`);
    };

    const setOther = (kind, page = 1) => {
      otherTabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.otherTab === kind)));
      otherRows.forEach((row) => {
        row.hidden = row.dataset.otherRow !== kind || Number(row.dataset.otherPage || "1") !== page;
      });
      otherPaginations.forEach((nav) => {
        nav.hidden = nav.dataset.otherPagination !== kind || nav.querySelectorAll("button").length < 2;
      });
      otherPageButtons.forEach((button) => button.setAttribute("aria-current", String(button.dataset.otherKind === kind && Number(button.dataset.otherPage) === page)));
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => setPanel(tab.dataset.learningTab)));
    otherTabs.forEach((tab) => tab.addEventListener("click", () => setOther(tab.dataset.otherTab, 1)));
    otherPageButtons.forEach((button) => button.addEventListener("click", () => setOther(button.dataset.otherKind, Number(button.dataset.otherPage))));

    const initial = new URLSearchParams(window.location.search).get("section");
    if (initial && tabs.some((tab) => tab.dataset.learningTab === initial)) {
      setPanel(initial);
    } else {
      const activeTab = tabs.find((tab) => tab.getAttribute("aria-selected") === "true");
      if (activeTab) {
        if (heroTitle && activeTab.dataset.title) {
          heroTitle.textContent = activeTab.dataset.title;
        }
        if (heroSubtitle && activeTab.dataset.subtitle) {
          heroSubtitle.textContent = activeTab.dataset.subtitle;
        }
      }
    }
    setOther(otherTabs[0]?.dataset.otherTab, 1);
  })();
</script>

<style>
  .learning-hero-subtitle {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }
</style>


