const t = qrTranslations[locale] ?? qrTranslations["en"] ?? qrTranslations["zh-CN"];
---

<div class="contact-qr-grid" data-qr-expiry={wechatQr.expiresAt} data-qr-uploaded={wechatQr.uploadedAt}>
  <div class="contact-qr-card contact-qr-card--qq">
    <img
      class="contact-qr-card__image"
      src="/images/contact/qq-group-1105424769.jpg"
      alt={t.qqAlt}
      loading="eager"
      decoding="async"
    />
    <div class="contact-qr-card__content">
      <span>{t.qqBadge}</span>
      <strong>{t.qqTitle}</strong>
      <p>{t.qqDesc}</p>
      <p class="contact-qr-card__note">{t.qqNote}</p>
    </div>
  </div>

  <div class="contact-qr-card contact-qr-card--wechat" id="wechat" data-wechat-qr>
    <div class="contact-qr-card__media">
      <img
        class="contact-qr-card__image"
        src={wechatQr.image}
        alt={t.wechatAlt}
        loading="eager"
        decoding="async"
      />
      <div class="contact-qr-card__expired" data-qr-expired hidden>
        <strong>{t.wechatExpiredTitle}</strong>
        <span>{t.wechatExpiredDesc}</span>
      </div>
    </div>
    <div class="contact-qr-card__content">
      <span>{t.wechatBadge}</span>
      <strong>{t.wechatTitle}</strong>
      <p>{t.wechatDesc}</p>
      <!-- 微信号：未过期时隐藏，仅在倒计时结束（已过期）时才出现 -->
      <strong class="contact-qr-card__handle" data-qr-handle hidden style="display: none;">{t.wechatHandle}</strong>
      <p class="contact-qr-card__countdown" data-qr-countdown aria-live="polite">{t.countdownInitial}</p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const grids = document.querySelectorAll("[data-qr-expiry]");
    const formatRemaining = (expiresAt, lang) => {
      const remaining = new Date(expiresAt).getTime() - Date.now();
      if (remaining <= 0) return null;
      const days = Math.floor(remaining / 86400000);
      const hours = Math.floor((remaining % 86400000) / 3600000);
      const minutes = Math.floor((remaining % 3600000) / 60000);
      if (lang === "zh-CN" || lang.startsWith("zh")) {
        return days > 0
          ? `有效期剩余：${days} 天 ${hours} 小时 ${minutes} 分`
          : `即将过期：剩余 ${hours} 小时 ${minutes} 分`;
      }
      if (lang === "ja") {
        return days > 0
          ? `有効期限残り：${days}日 ${hours}時間 ${minutes}分`
          : `まもなく期限切れ：残り ${hours}時間 ${minutes}分`;
      }
      if (lang === "ko") {
        return days > 0
          ? `유효기간 남음: ${days}일 ${hours}시간 ${minutes}분`
          : `곧 만료: 남은 시간 ${hours}시간 ${minutes}분`;
      }
      if (lang === "es") {
        return days > 0
          ? `Válido: quedan ${days}d ${hours}h ${minutes}m`
          : `Expira pronto: quedan ${hours}h ${minutes}m`;
      }
      if (lang === "fr") {
        return days > 0
          ? `Valide : reste ${days}j ${hours}h ${minutes}m`
          : `Expire bientôt : reste ${hours}h ${minutes}m`;
      }
      if (lang === "de") {
        return days > 0
          ? `Gültig: noch ${days}T ${hours}Std ${minutes}Min`
          : `Läuft bald ab: noch ${hours}Std ${minutes}Min`;
      }
      if (lang === "ru") {
        return days > 0
          ? `Действителен: осталось ${days}д ${hours}ч ${minutes}мин`
          : `Скоро истечет: осталось ${hours}ч ${minutes}мин`;
      }
      if (lang === "pt") {
        return days > 0
          ? `Válido: restam ${days}d ${hours}h ${minutes}m`
          : `Expira em breve: restam ${hours}h ${minutes}m`;
      }
      if (lang === "it") {
        return days > 0
          ? `Valido: restano ${days}g ${hours}h ${minutes}m`
          : `In scadenza: restano ${hours}h ${minutes}m`;
      }
      if (lang === "ar") {
        return days > 0
          ? `الصلاحية المتبقية: ${days} يوم و${hours} ساعة و${minutes} دقيقة`
          : `ينتهي قريباً: متبقي ${hours} ساعة و${minutes} دقيقة`;
      }
      if (lang === "hi") {
        return days > 0
          ? `वैध: ${days} दिन ${hours} घंटे ${minutes} मिनट शेष`
          : `जल्द समाप्त: ${hours} घंटे ${minutes} मिनट शेष`;
      }
      return days > 0
        ? `Valid: ${days}d ${hours}h ${minutes}m remaining`
        : `Expiring soon: ${hours}h ${minutes}m remaining`;
    };

    const getExpiredText = (lang) => {
      if (lang === "zh-CN" || lang.startsWith("zh")) return "已过期（请添加微信号：hooosberg）";
      if (lang === "ja") return "期限切れ（WeChat ID: hooosberg を追加してください）";
      if (lang === "ko") return "만료됨 (WeChat ID: hooosberg 추가)";
      if (lang === "es") return "Caducado (Contactar WeChat: hooosberg)";
      if (lang === "fr") return "Expiré (Contacter WeChat : hooosberg)";
      if (lang === "de") return "Abgelaufen (WeChat-Kontakt: hooosberg)";
      if (lang === "ru") return "Истек (Контакт WeChat: hooosberg)";
      if (lang === "pt") return "Expirado (Adicionar WeChat: hooosberg)";
      if (lang === "it") return "Scaduto (Contatto WeChat: hooosberg)";
      if (lang === "ar") return "منتهي الصلاحية (أضف WeChat: hooosberg)";
      if (lang === "hi") return "समाप्त (WeChat संपर्क: hooosberg)";
      return "Expired (Contact WeChat: hooosberg)";
    };

    grids.forEach((grid) => {
      const expiry = grid.getAttribute("data-qr-expiry");
      const qr = grid.querySelector("[data-wechat-qr]");
      const image = qr?.querySelector(".contact-qr-card__image");
      const expired = qr?.querySelector("[data-qr-expired]");
      const countdown = qr?.querySelector("[data-qr-countdown]");
      const handle = qr?.querySelector("[data-qr-handle]");
      const lang = document.documentElement.lang || "zh-CN";
      if (!expiry || !qr || !image || !expired || !countdown) return;

      const update = () => {
        const label = formatRemaining(expiry, lang);
        if (label) {
          countdown.textContent = label;
          image.hidden = false;
          expired.hidden = true;
          if (handle) {
            handle.hidden = true;
            handle.style.display = "none";
          }
          qr.classList.remove("is-expired");
          return;
        }
        image.hidden = true;
        expired.hidden = false;
        if (handle) {
          handle.hidden = false;
          handle.style.display = "";
        }
        countdown.textContent = getExpiredText(lang);
        qr.classList.add("is-expired");
      };

      update();
      window.setInterval(update, 10000);
    });
  })();
</script>
