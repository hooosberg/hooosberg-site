    price: isEnglish ? "Moderate (WeChat Free Use)" : "适中 · 微信端免配置",
    killer: isEnglish ? "Native synergy with WeChat, Tencent Yuanbao search, Enterprise WeChat document co-editing, and Tencent Cloud pipelines." : "与微信生态、腾讯元宝、企业微信文档及腾讯云服务的天然无缝打通，日常办公免折腾开箱即用。",
    shortcoming: isEnglish ? "Less appealing for independent frontier hackers seeking bleeding-edge experimental toolchains." : "面向独立极客开发者的前沿实验性工具链较轻，前沿跑分虽稳健但较少在极客圈引发刷屏。",
    priceDetail: isEnglish ? "Free directly in WeChat & Yuanbao for consumers; enterprise APIs bundled economically on Tencent Cloud." : "个人用户在微信与元宝中可直接免费使用；企业级 API 依托腾讯云体系打包，成本可控。",
    quote: isEnglish ? "\"We maintain a steady daily posture, yet when large-scale enterprise collaboration calls, our resilience shines.\"" : "“平日不高调炫技，真到大局协作与生态落地时，才见真章。”",
    description: isEnglish ? "Hunyuan is like Lu Su: dependable, wealthy in infrastructure, and quietly supporting the entire enterprise framework. Its greatest advantage is its natural embedding inside China's largest digital communication ecosystem." : "混元像鲁肃：性情沉厚、家底殷实。它很少参与互联网上的跑分互撕，但当你需要把 AI 塞进微信客服、公众号、腾讯文档与企业微信里时，它是最省心的正统管家。重在稳扎稳打、润物细无声。",
    advice: isEnglish ? "For seamless WeChat integration, office collaboration, and enterprise ecosystem workflows, Lu Su is your solid partner." : "业务与微信生态、企业办公协同紧密绑定，需要稳定无痛交付，鲁肃是最可靠的合伙人。",
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/LuSu.jpg",
    source: "https://commons.wikimedia.org/wiki/File:LuSu.jpg",
    sourceName: isEnglish ? "Wikimedia Commons · Qing Dynasty Portrait" : "Wikimedia Commons · 清代三国绣像",
    officialUrl: "https://yuanbao.tencent.com/",
  },
  {
    rank: 11,
    ai: isEnglish ? "Doubao (豆包)" : "豆包 Doubao",
    family: isEnglish ? "ByteDance" : "字节跳动",
    character: isEnglish ? "Liu Bei (刘备)" : "刘备",
    mark: "刘",
    camp: isEnglish ? "Shu Han · Benevolent Sovereign" : "蜀汉 · 主公",
    tier: isEnglish ? "T2 · Universal Mass Adoption" : "T2 · 仁德亲民",
    role: isEnglish ? "No technical barriers; gives millions of everyday people access to accessible AI." : "仁德爱民，大众普及第一；不设门槛、全端免费，让千家万户真正用上 AI。",
    tags: isEnglish ? ["Universal Free", "Zero Barrier", "Mobile Mass Favorite", "Everyday Helper"] : ["全民免费", "零门槛交互", "国民级日活", "日常全能助手"],
    stats: { "综合": 84, "编程": 74, "推理": 80, "长文本": 86, "多模态": 85, "性价比": 98 },
    price: isEnglish ? "Ultra Friendly (Free App)" : "极便宜 · 全民免费",
    killer: isEnglish ? "Massive user adoption, intuitive voice chat on mobile, and ultra-cheap Volcengine API infrastructure for businesses." : "全国最大规模的大众日活普及、手机端极简语音与问答、火山引擎普惠级极低成本商业 API。",
    shortcoming: isEnglish ? "Not suited for deep architectural refactoring or academic math research compared to Claude/o3/R1." : "不适合极其硬核的大型底层软件重构与学术级定理证明，更侧重于大众日常与通用工作流。",
    priceDetail: isEnglish ? "Consumer app & mobile voice features are 100% free; enterprise Volcengine token prices lead the market down." : "C 端 App 与手机语音助手完全免费；B 端火山引擎价格极低，彻底打掉大众使用门槛。",
    quote: isEnglish ? "\"Let us first ensure every ordinary individual can walk alongside AI without friction.\"" : "“先让天下所有人都能无门槛用上 AI，方为根本。”",
    description: isEnglish ? "Doubao is like Liu Bei: its supreme superpower is affinity and benevolence. It reaches every regular smartphone user, communicates naturally, and breaks down all psychological barriers to using AI." : "豆包像刘备：最大神通是“得人心与亲和力”。它离大众用户最近、上手毫无心理负担。对大量非技术从业者、学生和日常办公人员来说，豆包是他们真正天天在用的 AI 助手。全方位降低门槛是它的时代使命。",
    advice: isEnglish ? "For effortless daily chats, frictionless mobile onboarding, and developing an everyday AI habit, start with Liu Bei." : "纯新手入门、日常轻办公、手机端语音随问随答，刘备是最好的第一站。",
    img: G + "chara_main_cid01.png",
    source: "https://www.gamecity.com.tw/sangokushi8-re/character.html",
    sourceName: isEnglish ? "Romance of the Three Kingdoms 8 Remake Official Site" : "《三国志8 REMAKE》官网",
    officialUrl: "https://www.doubao.com/",
  },
];

const copy = isEnglish
  ? {
      title: "AI Model Three Kingdoms",
      subtitle: "Instead of memorizing model parameters, remember which Three Kingdoms hero you need today.",
      headerBadge1: "One-screen Selector",
      headerBadge2: "← → Navigate",
      listTitle: "Model Leaderboard",
      family: "Family",
      overall: "Overall Score",
      price: "Cost / Price",
      officialLink: "Official Site ↗",
      radarTitle: "Six-Axis Capability Radar",
      radarSub: "Capability distribution, not benchmark scores",
      killerTitle: "🎯 Killer Scenarios & Strengths",
      shortcomingTitle: "⚠️ Limitations & Real-world Tips",
      bioTitle: "Hero Profile",
      priceTitle: "Cost & Pricing Analysis",
      adviceTitle: "How to choose as a builder?",
      prev: "◀ Previous",
      next: "Next ▶",
      toggleSide: "Collapse / Expand list",
      sourcePrefix: "↗ Image Source: ",
      hint: "Click any character on the left to jump directly",
    }
  : {
      title: "AI 三国群英谱",
      subtitle: "不是死记模型参数，而是记住：今天你需要哪位“三国人物”来帮你。",
      headerBadge1: "一屏角色选择器",
      headerBadge2: "← → 翻页",
      listTitle: "综合推荐榜",
      family: "模型家族",
      overall: "综合推荐",
      price: "军饷 / 价格感",
      officialLink: "官网 / 平台直达 ↗",
      radarTitle: "六维战力雷达图",
      radarSub: "能力分布，不是官方跑分",
      killerTitle: "🎯 杀手锏场景 / 最强主场",
      shortcomingTitle: "⚠️ 真实短板 / 避坑指南",
      bioTitle: "人物简介",
      priceTitle: "军饷与价格深度解析",
      adviceTitle: "新手实战怎么选？",
      prev: "◀ 上一个",
      next: "下一个 ▶",
      toggleSide: "收起 / 展开排行榜",
      sourcePrefix: "↗ 查看人物图片来源",
      hint: "点击左侧排行榜可直接跳转",
    };
---

<div class:list={["sanguo-interactive-root", { "is-embedded": embedded }]} data-sanguo-root>
  {!embedded && (
    <header class="sanguo-top-header">
      <div class="sanguo-brand">
        <div class="sanguo-brand-mark">AI</div>
        <div>
          <h2>{copy.title}</h2>
          <p>{copy.subtitle}</p>
        </div>
      </div>
      <div class="sanguo-header-right">
        <span class="sanguo-header-pill">{copy.headerBadge1}</span>
        <span class="sanguo-header-pill">{copy.headerBadge2}</span>
      </div>
    </header>
  )}

  <div class="sanguo-shell" data-sanguo-shell>
    <aside class="sanguo-sidebar" aria-label={copy.listTitle}>
      <div class="sanguo-side-head">
        <strong>{copy.listTitle}</strong>
        <button class="sanguo-toggle-btn" data-sanguo-toggle title={copy.toggleSide} aria-label={copy.toggleSide}>☰</button>
      </div>
      <div class="sanguo-rank-list" data-sanguo-rank-list>
        {models.map((m, i) => (
          <button
            class:list={["sanguo-rank-item", { active: i === 0 }]}
            type="button"
            data-sanguo-index={i}
          >
            <span class="sanguo-rank-no">{m.rank}</span>
            <span class="sanguo-rank-meta">
              <span class="sanguo-rank-ai">{m.ai}</span>
              <span class="sanguo-rank-char">{m.character}</span>
            </span>
            <span class="sanguo-rank-score">{m.stats.综合}</span>
          </button>
        ))}
      </div>
    </aside>

    <main class="sanguo-stage">
      <section class="sanguo-character-view">
        <article class="sanguo-portrait-card">
          <div class="sanguo-portrait-top">
            <span class="sanguo-camp" data-sanguo-camp>{models[0].camp}</span>
            <span class="sanguo-tier" data-sanguo-tier>{models[0].tier}</span>
          </div>
          <div class="sanguo-portrait-area">
            <img
              class="sanguo-portrait-img"
              data-sanguo-img
              src={models[0].img}
              alt={`${models[0].character}人物立绘`}
              referrerpolicy="no-referrer"
            />
            <div class="sanguo-fallback-mark" data-sanguo-fallback style="display:none;">{models[0].mark}</div>
          </div>
          <div class="sanguo-portrait-bottom">
            <div class="sanguo-name-row">
              <div class="sanguo-char-name" data-sanguo-char-name>{models[0].character}</div>
              <div class="sanguo-ai-name" data-sanguo-ai-name>{models[0].ai}</div>
            </div>
            <div class="sanguo-role-line" data-sanguo-role-line>{models[0].role}</div>
            <div class="sanguo-tag-row" data-sanguo-tag-row>
              {models[0].tags.map((t) => <span class="sanguo-tag">{t}</span>)}
            </div>
            <a
              class="sanguo-source-link"
              data-sanguo-source-link
              href={models[0].source}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.sourcePrefix} {models[0].sourceName}
            </a>
          </div>
        </article>

        <div class="sanguo-right-column">
          <article class="sanguo-stats-card">
            <div class="sanguo-stat-head">
              <div class="sanguo-head-box">
                <div class="sanguo-head-label">{copy.family}</div>
                <div class="sanguo-head-value" data-sanguo-family>{models[0].family}</div>
              </div>
              <div class="sanguo-head-box">
                <div class="sanguo-head-label">{copy.overall}</div>
                <div class="sanguo-head-value" data-sanguo-overall>{models[0].stats.综合} / 100</div>
              </div>
              <div class="sanguo-head-box">
                <div class="sanguo-head-label">{copy.price}</div>
                <div class="sanguo-head-value" data-sanguo-price>{models[0].price}</div>
              </div>
              <a
                class="sanguo-head-action"
                data-sanguo-official
                href={models[0].officialUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {copy.officialLink}
              </a>
            </div>

            <div class="sanguo-stat-body">
              <div class="sanguo-radar-wrap">
                <div class="sanguo-module-title">
                  {copy.radarTitle} <span>{copy.radarSub}</span>
                </div>
                <div class="sanguo-canvas-box">
                  <canvas class="sanguo-radar-canvas" data-sanguo-radar width="360" height="360"></canvas>
                </div>
              </div>

              <div class="sanguo-deep-analysis">
                <div class="sanguo-analysis-card sanguo-analysis-card--killer">
                  <div class="sanguo-analysis-head">
                    <span class="sanguo-analysis-badge sanguo-analysis-badge--killer">{copy.killerTitle}</span>
                  </div>
                  <p class="sanguo-analysis-text" data-sanguo-killer>{models[0].killer}</p>
                </div>

                <div class="sanguo-analysis-card sanguo-analysis-card--shortcoming">
                  <div class="sanguo-analysis-head">
                    <span class="sanguo-analysis-badge sanguo-analysis-badge--shortcoming">{copy.shortcomingTitle}</span>
                  </div>
                  <p class="sanguo-analysis-text" data-sanguo-shortcoming>{models[0].shortcoming}</p>
                </div>
              </div>
            </div>
          </article>

          <article class="sanguo-bio-card">
            <div class="sanguo-bio-main">
              <div class="sanguo-bio-title">
                <strong>{copy.bioTitle}</strong>
                <span class="sanguo-quote" data-sanguo-quote>{models[0].quote}</span>
              </div>
              <div class="sanguo-bio-desc" data-sanguo-desc>{models[0].description}</div>
              <div class="sanguo-advice-inline">
                <strong>{copy.adviceTitle}</strong>
                <p data-sanguo-advice>{models[0].advice}</p>
              </div>
            </div>
            
            <div class="sanguo-price-box">
              <div class="sanguo-price-head">
                <strong>{copy.priceTitle}</strong>
                <span class="sanguo-price-pill" data-sanguo-price-pill>{copy.price}：{models[0].price}</span>
              </div>
              <p class="sanguo-price-detail" data-sanguo-pricedetail>{models[0].priceDetail}</p>
            </div>
          </article>
        </div>
      </section>

      <footer class="sanguo-nav">
        <div class="sanguo-nav-left">
          <button class="sanguo-nav-btn" data-sanguo-prev>{copy.prev}</button>
          <button class="sanguo-nav-btn" data-sanguo-next>{copy.next}</button>
          <span class="sanguo-page-indicator" data-sanguo-page>1 / {models.length}</span>
        </div>
        <div class="sanguo-nav-right">
          <span class="sanguo-hint">{copy.hint}</span>
        </div>
      </footer>
    </main>
  </div>
</div>

<script define:vars={{ models, copy, isEnglish }}>
  document.querySelectorAll("[data-sanguo-root]").forEach((root) => {
    if (root.__sanguoInitialized) return;
    root.__sanguoInitialized = true;

    let index = 0;
    const shell = root.querySelector("[data-sanguo-shell]");
    const rankList = root.querySelector("[data-sanguo-rank-list]");
    const toggleBtn = root.querySelector("[data-sanguo-toggle]");
    const campEl = root.querySelector("[data-sanguo-camp]");
    const tierEl = root.querySelector("[data-sanguo-tier]");
    const imgEl = root.querySelector("[data-sanguo-img]");
    const fallbackEl = root.querySelector("[data-sanguo-fallback]");
    const charNameEl = root.querySelector("[data-sanguo-char-name]");
    const aiNameEl = root.querySelector("[data-sanguo-ai-name]");
    const roleLineEl = root.querySelector("[data-sanguo-role-line]");
    const tagRowEl = root.querySelector("[data-sanguo-tag-row]");
    const sourceLinkEl = root.querySelector("[data-sanguo-source-link]");
    const familyEl = root.querySelector("[data-sanguo-family]");
    const overallEl = root.querySelector("[data-sanguo-overall]");
    const priceEl = root.querySelector("[data-sanguo-price]");
    const officialEl = root.querySelector("[data-sanguo-official]");
    const killerEl = root.querySelector("[data-sanguo-killer]");
    const shortcomingEl = root.querySelector("[data-sanguo-shortcoming]");
    const quoteEl = root.querySelector("[data-sanguo-quote]");
    const descEl = root.querySelector("[data-sanguo-desc]");
    const priceDetailEl = root.querySelector("[data-sanguo-pricedetail]");
    const pricePillEl = root.querySelector("[data-sanguo-price-pill]");
    const adviceEl = root.querySelector("[data-sanguo-advice]");
    const pageEl = root.querySelector("[data-sanguo-page]");
    const prevBtn = root.querySelector("[data-sanguo-prev]");
    const nextBtn = root.querySelector("[data-sanguo-next]");
    const radarCanvas = root.querySelector("[data-sanguo-radar]");

    const drawRadar = (stats) => {
      if (!radarCanvas) return;
      const ctx = radarCanvas.getContext("2d");
      if (!ctx) return;
      const labels = Object.keys(stats);
      const vals = Object.values(stats);
      const cx = 180;
      const cy = 180;
      const R = 104;
      const n = labels.length;

      ctx.clearRect(0, 0, 360, 360);
      const glow = ctx.createRadialGradient(cx, cy, 10, cx, cy, 140);
      glow.addColorStop(0, "rgba(226,190,114,.09)");
      glow.addColorStop(1, "rgba(226,190,114,0)");
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, 360, 360);

      for (let lv = 1; lv <= 5; lv++) {
        ctx.beginPath();
        for (let i = 0; i < n; i++) {
          const a = -Math.PI / 2 + (i * 2 * Math.PI) / n;
          const r = (R * lv) / 5;
          const x = cx + Math.cos(a) * r;
          const y = cy + Math.sin(a) * r;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.strokeStyle = lv === 5 ? "rgba(226,190,114,.32)" : "rgba(255,255,255,.08)";
        ctx.lineWidth = lv === 5 ? 1.5 : 1;
        ctx.stroke();
      }

      labels.forEach((lab, i) => {
        const a = -Math.PI / 2 + (i * 2 * Math.PI) / n;
        const x = cx + Math.cos(a) * R;
        const y = cy + Math.sin(a) * R;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(x, y);
        ctx.strokeStyle = "rgba(255,255,255,.08)";
        ctx.stroke();

        const lx = cx + Math.cos(a) * (R + 24);
        const ly = cy + Math.sin(a) * (R + 24);
        ctx.fillStyle = "rgba(235,242,244,.95)";
        ctx.font = "bold 12.5px sans-serif";
        ctx.textAlign = lx < cx - 8 ? "right" : lx > cx + 8 ? "left" : "center";
        ctx.textBaseline = ly < cy - 6 ? "bottom" : ly > cy + 6 ? "top" : "middle";
        ctx.fillText(lab, lx, ly);
      });

      ctx.beginPath();
      vals.forEach((v, i) => {
        const a = -Math.PI / 2 + (i * 2 * Math.PI) / n;
        const r = (R * v) / 100;
        const x = cx + Math.cos(a) * r;
        const y = cy + Math.sin(a) * r;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.closePath();
      ctx.fillStyle = "rgba(119,197,216,.22)";
      ctx.strokeStyle = "rgba(247,223,170,.95)";
      ctx.lineWidth = 2.2;
      ctx.fill();
      ctx.stroke();

      vals.forEach((v, i) => {
        const a = -Math.PI / 2 + (i * 2 * Math.PI) / n;
        const r = (R * v) / 100;
        const x = cx + Math.cos(a) * r;
        const y = cy + Math.sin(a) * r;
        ctx.beginPath();
        ctx.arc(x, y, 3.8, 0, Math.PI * 2);
        ctx.fillStyle = "#f7dfaa";
        ctx.fill();
      });

      ctx.fillStyle = "#f7dfaa";
      ctx.font = "bold 13px sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(isEnglish ? "AI Power" : "AI 战力", cx, cy);
    };

    const updateRankActive = () => {
      if (!rankList) return;
      const items = rankList.querySelectorAll("[data-sanguo-index]");
      items.forEach((item, i) => {
        const isActive = i === index;
        item.classList.toggle("active", isActive);
        item.setAttribute("aria-selected", isActive ? "true" : "false");
      });
      const activeEl = rankList.querySelector(".active");
      if (activeEl) {
        activeEl.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }
    };

    const render = () => {
      const d = models[index];
      if (!d) return;

      if (campEl) campEl.textContent = d.camp;
      if (tierEl) tierEl.textContent = d.tier;
      if (charNameEl) charNameEl.textContent = d.character;
      if (aiNameEl) aiNameEl.textContent = d.ai;
      if (roleLineEl) roleLineEl.textContent = d.role;
      if (tagRowEl) {
        tagRowEl.innerHTML = d.tags.map((t) => `<span class="sanguo-tag">${t}</span>`).join("");
      }
      if (sourceLinkEl) {
        sourceLinkEl.href = d.source;
        sourceLinkEl.textContent = `${copy.sourcePrefix} ${d.sourceName}`;
      }
      if (familyEl) familyEl.textContent = d.family;
      if (overallEl) overallEl.textContent = `${d.stats.综合} / 100`;
      if (priceEl) priceEl.textContent = d.price;
      if (officialEl) officialEl.href = d.officialUrl;
      if (killerEl) killerEl.textContent = d.killer;
      if (shortcomingEl) shortcomingEl.textContent = d.shortcoming;
      if (quoteEl) quoteEl.textContent = d.quote;
      if (descEl) descEl.textContent = d.description;
      if (priceDetailEl) priceDetailEl.textContent = d.priceDetail;
      if (pricePillEl) pricePillEl.textContent = `${copy.price}：${d.price}`;
      if (adviceEl) adviceEl.textContent = d.advice;
      if (pageEl) pageEl.textContent = `${index + 1} / ${models.length}`;

      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === models.length - 1;

      if (fallbackEl) {
        fallbackEl.textContent = d.mark;
        fallbackEl.style.display = "none";
      }
      if (imgEl) {
        imgEl.style.display = "block";
        imgEl.src = d.img;
        imgEl.alt = `${d.character}人物立绘`;
      }

      drawRadar(d.stats);
      updateRankActive();
    };

    if (imgEl) {
      imgEl.onerror = () => {
        imgEl.style.display = "none";
        if (fallbackEl) fallbackEl.style.display = "grid";
      };
    }

    if (toggleBtn && shell) {
      toggleBtn.onclick = () => shell.classList.toggle("sidebar-collapsed");
    }

    if (prevBtn) {
      prevBtn.onclick = () => {
        if (index > 0) {
          index--;
          render();
        }
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        if (index < models.length - 1) {
          index++;
          render();
        }
      };
    }

    if (rankList) {
      rankList.querySelectorAll("[data-sanguo-index]").forEach((item) => {
        item.addEventListener("click", () => {
          const targetIndex = Number(item.getAttribute("data-sanguo-index"));
          if (!isNaN(targetIndex) && targetIndex >= 0 && targetIndex < models.length) {
            index = targetIndex;
            render();
          }
        });
      });
    }

    window.addEventListener("keydown", (e) => {
      const activeElement = document.activeElement;
      if (activeElement && (activeElement.tagName === "INPUT" || activeElement.tagName === "TEXTAREA")) return;
      if (root.closest("[hidden]")) return;

      if (e.key === "ArrowLeft" && index > 0) {
        index--;
        render();
      }
      if (e.key === "ArrowRight" && index < models.length - 1) {
        index++;
        render();
      }
    });

    render();
  });
</script>

