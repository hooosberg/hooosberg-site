    source: "https://commons.wikimedia.org/wiki/File:Portrait_of_Xun_Yu.jpg",
    sourceName: isEnglish ? "Wikimedia Commons · Qing Dynasty Portrait" : "Wikimedia Commons · 清代绣像",
    officialUrl: "https://chatglm.cn/",
  },
  {
    rank: 9,
    ai: "MiniMax abab 6.5 / 海螺 AI",
