    role: isEnglish ? "Less praised by casual mainstream, yet masters of voice, video, and agentic storytelling never overlook it." : "凤雏展翅，奇谋善出；超拟真音色、长文创作与复杂 Agent 的隐藏高手。",
    tags: isEnglish ? ["Lifelike Audio", "Hailuo Video", "Agent Persona", "Long Form Craft"] : ["超拟真人声", "海螺AI视频", "长文创作", "Agent角色设定"],
