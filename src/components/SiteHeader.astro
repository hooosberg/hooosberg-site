---
import { Moon, Sun } from "@lucide/astro";
import {
  allLocales,
  brandNameByLocale,
  getAlternatePaths,
  localeMeta,
  toLocalizedPath,
  uiText,
  type Locale,
} from "../utils/i18n";

type Props = {
  locale?: Locale;
  currentPath?: string;
};

const { locale = "zh-CN", currentPath = Astro.url.pathname } = Astro.props;
const text = uiText[locale] ?? uiText["en"];
const navItems = text.nav.map(([label, href]) => ({ label, href: toLocalizedPath(href, locale) }));
const moreNavItems = text.moreNav.map(([label, href]) => ({ label, href: toLocalizedPath(href, locale) }));
const alternatePaths = getAlternatePaths(currentPath);
const targetLocale: Locale = locale === "en" ? "zh-CN" : "en";
const languageHref = alternatePaths[targetLocale] ?? (targetLocale === "en" ? "/en" : "/");
const homeHref = toLocalizedPath("/", locale);
const brandTitle = brandNameByLocale[locale] ?? "@Hooosberg";
const courseBuyUrl =
  "https://www.bilibili.com/cheese/play/ss402180572?csource=private_space_class_null&spm_id_from=333.1387.0.0";
---

<header class="site-header">
  <aside class="site-top-banner" aria-label="Course announcement">
    <div class="site-top-banner__inner">
      <span class="site-top-banner__text">
        {text.bannerText}
      </span>
      <a class="site-top-banner__cta" href={courseBuyUrl} target="_blank" rel="noreferrer">
        {text.bannerCta}
      </a>
    </div>
  </aside>
  <div class="site-header__inner">
    <a class="brand" href={homeHref} aria-label={text.brandAria}>
      <img class="brand-mark" src="/brand/hooosberg-ai-icon.png" alt="" />
      <span>
        <strong>{brandTitle}</strong>
      </span>
    </a>
    <div class="site-header__right">
      <nav class="nav-links" aria-label="Primary navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        {moreNavItems.length > 0 && <details class="nav-more">
          <summary>{text.moreNavLabel}</summary>
          <div class="nav-more__menu">
            {moreNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </details>}
      </nav>
      <div class="site-header__actions">
        <details class="language-dropdown">
          <summary class="language-dropdown__toggle" aria-label="Language options" title="Language options">
            <svg class="language-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <span class="language-current-label">{localeMeta[locale]?.shortLabel ?? "Lang"}</span>
            <svg class="language-dropdown__arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="language-dropdown__menu">
            {allLocales.map((loc) => {
              const href = alternatePaths[loc] ?? (loc === "zh-CN" ? "/" : `/${loc}`);
              const isCurrent = loc === locale;
              return (
                <a
                  class:list={["language-dropdown__item", isCurrent && "is-active"]}
                  href={href}
                  hreflang={localeMeta[loc].hreflang}
                  data-language-switch
                  data-target-locale={loc}
                  data-locale-choice={loc}
                >
                  <span class="lang-short">{localeMeta[loc].shortLabel}</span>
                  <span class="lang-name">{localeMeta[loc].label}</span>
                </a>
              );
            })}
          </div>
        </details>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={text.themeToggle}>
          <Sun class="theme-icon theme-icon--sun" size={17} aria-hidden="true" />
          <Moon class="theme-icon theme-icon--moon" size={17} aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const header = document.querySelector(".site-header");
    const key = "hooosberg-theme";
    const updateHeaderMetrics = () => {
      if (!header) return;
      root.style.setProperty("--measured-site-header-height", `${Math.ceil(header.getBoundingClientRect().height)}px`);
    };
    const apply = (theme) => {
      root.dataset.theme = theme;
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
      });
    };
    updateHeaderMetrics();
    window.addEventListener("resize", updateHeaderMetrics, { passive: true });
    window.addEventListener("orientationchange", updateHeaderMetrics, { passive: true });
    if (header && "ResizeObserver" in window) {
      new ResizeObserver(updateHeaderMetrics).observe(header);
    }
    apply(root.dataset.theme || "light");
    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        localStorage.setItem(key, next);
        apply(next);
      });
    });
    document.querySelectorAll("[data-language-switch]").forEach((link) => {
      link.addEventListener("click", () => {
        const targetLocale = link.getAttribute("data-target-locale");
        if (targetLocale) {
          localStorage.setItem("hooosberg-locale", targetLocale);
        }
      });
    });
    document.querySelectorAll("[data-locale-choice]").forEach((link) => {
      link.addEventListener("click", () => {
        const choice = link.getAttribute("data-locale-choice");
        if (choice) {
          localStorage.setItem("hooosberg-locale", choice);
        }
        const details = link.closest("details");
        if (details) details.removeAttribute("open");
      });
    });
    document.addEventListener("click", (e) => {
      const dropdown = document.querySelector(".language-dropdown");
      if (dropdown && dropdown.hasAttribute("open") && !dropdown.contains(e.target)) {
        dropdown.removeAttribute("open");
      }
    });
  })();
</script>
