---
import arenaData from "../data/arena-leaderboard.json";

type Props = {
  locale?: "zh-CN" | "en";
  embedded?: boolean;
};

const { locale = "zh-CN", embedded = false } = Astro.props;

// 找到置顶总榜（对应 arena.ai 官方首页面板顶部的 Agent 智能体总榜）
const overallCat = arenaData.categories.find((c) => c.id === "agent" || c.id === "overall") || arenaData.categories[0];
// 严格按照 arena.ai 官方首页排布的分项子榜单
const subCategories = arenaData.categories.filter((c) => c.id !== overallCat?.id);

function formatScore(item: any) {
  if (!item) return null;
  if (item.scoreText) return item.scoreText;
  if (item.rating != null) {
    if (typeof item.rating === "string" && (item.rating.includes("%") || item.rating.includes("分"))) {
      return item.rating;
    }
    return `${item.rating}分`;
  }
  return null;
}

function forecastClass(item: any) {
  return item?.forecastKey ? `model-pill--forecast-${item.forecastKey}` : "";
}

// 序列化所有分类全量数据供底部下拉菜单秒级切换查阅
const categoriesDropdownPayload = JSON.stringify(
  arenaData.categories.map((c) => ({
    id: c.id,
    name: c.name,
    icon: c.icon,
    tagline: c.tagline,
    desc: c.desc,
    isAgent: !!c.isAgent,
    totalCount: c.totalCount,
    fullList: c.fullList,
  }))
);
---

<div class:list={["tier-root", { "is-embedded": embedded }]} data-tier-root>
  <!-- 头部极简标题区（不套框，干净利落） -->
  <header class="tier-header-clean">
    <div class="tier-badge-pill">Arena 实测 + 新品预测 · 5档战力</div>
    <h2 class="tier-main-title">AI模型性能排行榜（从夯到拉天梯榜）</h2>
    <p class="tier-subtitle">
      原有模型按 Agent Arena 盲测排名；三款新模型暂按公开基准预测，Arena 还没有足够实测样本。
    </p>
  </header>

  <aside class="tier-forecast-note" aria-label="新模型预测说明">
    <div class="tier-forecast-legend">
      <span class="tier-forecast-key tier-forecast-key--opus55"><i></i>Claude Opus 5.5</span>
      <span class="tier-forecast-key tier-forecast-key--gpt6sol"><i></i>GPT 6 Sol</span>
      <span class="tier-forecast-key tier-forecast-key--gpt6luna"><i></i>GPT 6 Luna</span>
    </div>
    <p>彩色分数是编辑预测，不是 Arena 实测；参考公开基准与任务成本，见 <a href="https://www.anthropic.com/claude/opus" target="_blank" rel="noopener noreferrer">Anthropic 评测</a>、<a href="https://openai.com/index/introducing-gpt-6-sol-and-luna/" target="_blank" rel="noopener noreferrer">OpenAI 评测</a>，待 Arena 累积盲测后再校正。</p>
  </aside>

  <!-- 快速跳转条（纯净胶囊直接平铺，无嵌套外框） -->
  <nav class="tier-quick-nav-flat" aria-label="分项快速跳转">
    <span class="quick-nav-title">快速跳转：</span>
    <div class="quick-nav-list">
      <a href={`#cat-${overallCat.id}`} class="quick-nav-chip">
        <span>{overallCat.icon}</span>
        <span>{overallCat.name}</span>
      </a>
      {subCategories.map((cat) => (
        <a href={`#cat-${cat.id}`} class="quick-nav-chip">
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
        </a>
      ))}
      <a href="#cat-more-rankings" class="quick-nav-chip quick-nav-chip--more">
        <span>📑</span>
        <span>更多榜单下拉</span>
      </a>
    </div>
  </nav>

  <!-- 1. 最上面：置顶总榜（全宽居中置顶，对应 arena.ai 官方首页面板顶部的 Agent 智能体总榜） -->
  <div id="cat-overall" style="position: relative; top: -10px;"></div>
  <section class="tier-overall-section" id={`cat-${overallCat.id}`}>
    <div class="tier-section-wrapper">
      <!-- 头部纯净无右上角按钮，专注于信息展现 -->
      <div class="tier-cat-head">
        <div class="tier-head-left">
          <span class="tier-head-icon">{overallCat.icon}</span>
          <div class="tier-head-text">
            <h3 class="tier-head-title">{overallCat.name} · {overallCat.tagline}</h3>
            <p class="tier-head-desc">{overallCat.desc}（收录 {overallCat.totalCount} 款主流模型）</p>
          </div>
        </div>
      </div>

      <!-- 5 档梗图天梯 -->
      <div class="tier-table">
        <!-- 夯 -->
        <div class="tier-row tier-row--hang">
          <div class="tier-label tier-label--hang" style={`background-color: ${overallCat.tiers.hang.bg}; color: ${overallCat.tiers.hang.textColor};`}>
            <span class="tier-label-text">夯</span>
          </div>
          <div class="tier-content">
            {overallCat.tiers.hang.items.map((item) => (
              <div
                class:list={["model-pill", "model-pill--hang", forecastClass(item), { "model-pill--top10": item.displayRank <= 10 }]}
                title={item.forecastBasis || `${item.name} (${item.organization}) - #${item.displayRank}`}
              >
                <span class="pill-rank">#{item.displayRank}</span>
                <span class="pill-name">{item.name}</span>
                <span class="pill-org">{item.organization}</span>
                {item.forecastKey && <span class="pill-forecast-badge">预测</span>}
                {formatScore(item) && <span class:list={["pill-score", { "pill-score--forecast": !!item.forecastKey }]}>{formatScore(item)}</span>}
              </div>
            ))}
          </div>
        </div>

        <!-- 顶级 -->
        <div class="tier-row tier-row--dingji">
          <div class="tier-label tier-label--dingji" style={`background-color: ${overallCat.tiers.dingji.bg}; color: ${overallCat.tiers.dingji.textColor};`}>
            <span class="tier-label-text">顶级</span>
          </div>
          <div class="tier-content">
            {overallCat.tiers.dingji.items.map((item) => (
              <div
                class:list={["model-pill", "model-pill--dingji", forecastClass(item), { "model-pill--top10": item.displayRank <= 10 }]}
                title={item.forecastBasis || `${item.name} (${item.organization}) - #${item.displayRank}`}
              >
                <span class="pill-rank">#{item.displayRank}</span>
                <span class="pill-name">{item.name}</span>
                <span class="pill-org">{item.organization}</span>
                {item.forecastKey && <span class="pill-forecast-badge">预测</span>}
                {formatScore(item) && <span class:list={["pill-score", { "pill-score--forecast": !!item.forecastKey }]}>{formatScore(item)}</span>}
              </div>
            ))}
          </div>
        </div>

        <!-- 人上人 -->
        <div class="tier-row tier-row--renshangren">
          <div class="tier-label tier-label--renshangren" style={`background-color: ${overallCat.tiers.renshangren.bg}; color: ${overallCat.tiers.renshangren.textColor};`}>
            <span class="tier-label-text">人上人</span>
          </div>
          <div class="tier-content">
            {overallCat.tiers.renshangren.items.map((item) => (
              <div
                class:list={["model-pill", "model-pill--renshangren", forecastClass(item), { "model-pill--top10": item.displayRank <= 10 }]}
                title={item.forecastBasis || `${item.name} (${item.organization}) - #${item.displayRank}`}
              >
                <span class="pill-rank">#{item.displayRank}</span>
                <span class="pill-name">{item.name}</span>
                <span class="pill-org">{item.organization}</span>
                {item.forecastKey && <span class="pill-forecast-badge">预测</span>}
                {formatScore(item) && <span class:list={["pill-score", { "pill-score--forecast": !!item.forecastKey }]}>{formatScore(item)}</span>}
              </div>
            ))}
          </div>
        </div>

        <!-- NPC -->
        <div class="tier-row tier-row--npc">
          <div class="tier-label tier-label--npc" style={`background-color: ${overallCat.tiers.npc.bg}; color: ${overallCat.tiers.npc.textColor};`}>
            <span class="tier-label-text">NPC</span>
          </div>
          <div class="tier-content">
            {overallCat.tiers.npc.items.map((item) => (
              <div
                class:list={["model-pill", "model-pill--npc", { "model-pill--top10": item.displayRank <= 10 }]}
                title={`${item.name} (${item.organization}) - #${item.displayRank}`}
              >
                <span class="pill-rank">#{item.displayRank}</span>
                <span class="pill-name">{item.name}</span>
                <span class="pill-org">{item.organization}</span>
                {formatScore(item) && <span class="pill-score">{formatScore(item)}</span>}
              </div>
            ))}
          </div>
        </div>

        <!-- 拉完了 -->
        <div class="tier-row tier-row--lawanle">
          <div class="tier-label tier-label--lawanle" style={`background-color: ${overallCat.tiers.lawanle.bg}; color: ${overallCat.tiers.lawanle.textColor};`}>
            <span class="tier-label-text">拉完了</span>
          </div>
          <div class="tier-content">
            {overallCat.tiers.lawanle.items.map((item) => (
              <div
                class:list={["model-pill", "model-pill--lawanle", { "model-pill--top10": item.displayRank <= 10 }]}
                title={`${item.name} (${item.organization}) - #${item.displayRank}`}
              >
                <span class="pill-rank">#{item.displayRank}</span>
                <span class="pill-name">{item.name}</span>
                <span class="pill-org">{item.organization}</span>
                {formatScore(item) && <span class="pill-score">{formatScore(item)}</span>}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 卡片底部明细展开按钮 -->
      <div class="tier-card-footer">
        <button
          type="button"
          class="tier-expand-trigger"
          data-toggle-table={overallCat.id}
          data-cat-name={overallCat.name}
          aria-expanded="false"
        >
          <span class="expand-icon">▼</span>
          <span class="expand-text">展开 {overallCat.name} 完整明细 (TOP 50)</span>
        </button>
      </div>

      <!-- 详细名单抽屉 (TOP 50) -->
      <div class="tier-detail-drawer" data-drawer-for={overallCat.id} hidden>
        <div class="tier-drawer-head">
          <h4 class="tier-drawer-title">{overallCat.name} · 详细排行榜 (TOP 50)</h4>
          <span class="tier-drawer-hint">Arena 记录为实测；新模型彩色条目为公开基准预测</span>
        </div>
        <div class="tier-table-wrapper">
          <table class="tier-full-table">
            <thead>
              <tr>
                <th style="width: 70px;">排名</th>
                <th>模型名称</th>
                <th style="width: 130px;">研发机构</th>
                <th style="width: 110px;">净提升 / 预测分</th>
                <th style="width: 80px;">链接</th>
              </tr>
            </thead>
            <tbody>
              {overallCat.fullList.map((item, rowIdx) => (
                <tr class:list={[{ "is-top3": rowIdx < 3 }, item.forecastKey ? `is-forecast is-forecast--${item.forecastKey}` : ""]}>
                  <td class="td-rank">
                    <span class:list={["rank-num", `rank-num--${rowIdx + 1}`]}>
                      {rowIdx === 0 ? "🥇 1" : rowIdx === 1 ? "🥈 2" : rowIdx === 2 ? "🥉 3" : rowIdx + 1}
                    </span>
                  </td>
                  <td class="td-name">
                    <strong>{item.name}</strong>
                    {item.forecastKey && <span class:list={["table-forecast-badge", `table-forecast-badge--${item.forecastKey}`]} title={item.forecastBasis}>预测</span>}
                  </td>
                  <td class="td-org">{item.organization}</td>
                  <td class="td-rating">
                    {item.rating ? (
                      <span class="rating-badge">{item.rating}</span>
                    ) : (
                      <span class="rating-rank-badge">第 {item.rank} 名</span>
                    )}
                  </td>
                  <td class="td-link">
                    {item.url ? (
                      <a href={item.url} target="_blank" rel="noopener noreferrer" class="link-btn">官网 ↗</a>
                    ) : (
                      <span class="link-none">-</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 下面左右两侧各一个榜单，依次往下排 (双列网格) -->
  <div class="tier-subcategories-grid">
    {subCategories.map((cat) => (
      <section class="tier-sub-card" id={`cat-${cat.id}`}>
        <!-- 头部纯净无右上角按钮，专注于信息展现 -->
        <div class="tier-cat-head tier-cat-head--compact">
          <div class="tier-head-left">
            <span class="tier-sub-icon">{cat.icon}</span>
            <div class="tier-head-text">
              <h4 class="tier-sub-name">{cat.name}</h4>
              <p class="tier-sub-tagline">{cat.tagline} · {cat.desc}</p>
            </div>
          </div>
        </div>

        <!-- 分项 5 档天梯 -->
        <div class="tier-table tier-table--compact">
          <!-- 夯 -->
          <div class="tier-row tier-row--hang">
            <div class="tier-label tier-label--hang" style={`background-color: ${cat.tiers.hang.bg}; color: ${cat.tiers.hang.textColor};`}>
              <span class="tier-label-text">夯</span>
            </div>
            <div class="tier-content">
              {cat.tiers.hang.items.slice(0, 3).map((item) => (
                <div
                  class:list={["model-pill", "model-pill--hang", { "model-pill--top10": item.displayRank <= 10 }]}
                  title={`${item.name} (${item.organization}) - #${item.displayRank}`}
                >
                  <span class="pill-rank">#{item.displayRank}</span>
                  <span class="pill-name">{item.name}</span>
                  <span class="pill-org">{item.organization}</span>
                  {formatScore(item) && <span class="pill-score">{formatScore(item)}</span>}
                </div>
              ))}
            </div>
          </div>

          <!-- 顶级 (确保不空档) -->
          <div class="tier-row tier-row--dingji">
            <div class="tier-label tier-label--dingji" style={`background-color: ${cat.tiers.dingji.bg}; color: ${cat.tiers.dingji.textColor};`}>
              <span class="tier-label-text">顶级</span>
            </div>
            <div class="tier-content">
              {cat.tiers.dingji.items.slice(0, 4).map((item) => (
                <div
                  class:list={["model-pill", "model-pill--dingji", { "model-pill--top10": item.displayRank <= 10 }]}
                  title={`${item.name} (${item.organization}) - #${item.displayRank}`}
                >
                  <span class="pill-rank">#{item.displayRank}</span>
                  <span class="pill-name">{item.name}</span>
                  <span class="pill-org">{item.organization}</span>
                  {formatScore(item) && <span class="pill-score">{formatScore(item)}</span>}
                </div>
              ))}
            </div>
          </div>

          <!-- 人上人 -->
          <div class="tier-row tier-row--renshangren">
            <div class="tier-label tier-label--renshangren" style={`background-color: ${cat.tiers.renshangren.bg}; color: ${cat.tiers.renshangren.textColor};`}>
              <span class="tier-label-text">人上人</span>
            </div>
            <div class="tier-content">
              {cat.tiers.renshangren.items.slice(0, 5).map((item) => (
                <div
                  class:list={["model-pill", "model-pill--renshangren", { "model-pill--top10": item.displayRank <= 10 }]}
                  title={`${item.name} (${item.organization}) - #${item.displayRank}`}
                >
                  <span class="pill-rank">#{item.displayRank}</span>
                  <span class="pill-name">{item.name}</span>
                  <span class="pill-org">{item.organization}</span>
                  {formatScore(item) && <span class="pill-score">{formatScore(item)}</span>}
                </div>
              ))}
            </div>
          </div>

          <!-- NPC -->
          <div class="tier-row tier-row--npc">
            <div class="tier-label tier-label--npc" style={`background-color: ${cat.tiers.npc.bg}; color: ${cat.tiers.npc.textColor};`}>
              <span class="tier-label-text">NPC</span>
            </div>
            <div class="tier-content">
              {cat.tiers.npc.items.slice(0, 6).map((item) => (
                <div
                  class:list={["model-pill", "model-pill--npc", { "model-pill--top10": item.displayRank <= 10 }]}
                  title={`${item.name} (${item.organization}) - #${item.displayRank}`}
                >
                  <span class="pill-rank">#{item.displayRank}</span>
                  <span class="pill-name">{item.name}</span>
                  <span class="pill-org">{item.organization}</span>
                  {formatScore(item) && <span class="pill-score">{formatScore(item)}</span>}
                </div>
              ))}
            </div>
          </div>

          <!-- 拉完了 -->
          <div class="tier-row tier-row--lawanle">
            <div class="tier-label tier-label--lawanle" style={`background-color: ${cat.tiers.lawanle.bg}; color: ${cat.tiers.lawanle.textColor};`}>
              <span class="tier-label-text">拉完了</span>
            </div>
            <div class="tier-content">
              {cat.tiers.lawanle.items.slice(0, 6).map((item) => (
                <div
                  class:list={["model-pill", "model-pill--lawanle", { "model-pill--top10": item.displayRank <= 10 }]}
                  title={`${item.name} (${item.organization}) - #${item.displayRank}`}
                >
                  <span class="pill-rank">#{item.displayRank}</span>
                  <span class="pill-name">{item.name}</span>
                  <span class="pill-org">{item.organization}</span>
                  {formatScore(item) && <span class="pill-score">{formatScore(item)}</span>}
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- 卡片底部明细展开按钮 -->
        <div class="tier-card-footer">
          <button
            type="button"
            class="tier-expand-trigger"
            data-toggle-table={cat.id}
            data-cat-name={cat.name}
            aria-expanded="false"
          >
            <span class="expand-icon">▼</span>
            <span class="expand-text">展开 {cat.name} 明细 (TOP {cat.fullList.length > 50 ? 50 : cat.fullList.length})</span>
          </button>
        </div>

        <!-- 详细名单抽屉 (TOP 50) -->
        <div class="tier-detail-drawer" data-drawer-for={cat.id} hidden>
          <div class="tier-drawer-head">
            <h5 class="tier-drawer-title">{cat.name} · 详细排名 (TOP 50)</h5>
            <span class="tier-drawer-hint">arena.ai 实测排位</span>
          </div>
          <div class="tier-table-wrapper">
            <table class="tier-full-table">
              <thead>
                <tr>
                  <th style="width: 60px;">排名</th>
                  <th>模型</th>
                  <th style="width: 110px;">机构</th>
                  <th style="width: 90px;">评分/战力</th>
                  <th style="width: 65px;">官网</th>
                </tr>
              </thead>
              <tbody>
                {cat.fullList.map((item, rowIdx) => (
                  <tr class:list={[{ "is-top3": rowIdx < 3 }]}>
                    <td class="td-rank">
                      <span class:list={["rank-num", `rank-num--${rowIdx + 1}`]}>
                        {rowIdx === 0 ? "🥇 1" : rowIdx === 1 ? "🥈 2" : rowIdx === 2 ? "🥉 3" : rowIdx + 1}
                      </span>
                    </td>
                    <td class="td-name"><strong>{item.name}</strong></td>
                    <td class="td-org">{item.organization}</td>
                    <td class="td-rating">
                      {formatScore(item) ? (
                        <span class="rating-badge">{formatScore(item)}</span>
                      ) : (
                        <span class="rating-rank-badge">第 {item.rank} 名</span>
                      )}
                    </td>
                    <td class="td-link">
                      {item.url ? (
                        <a href={item.url} target="_blank" rel="noopener noreferrer" class="link-btn">↗</a>
                      ) : (
                        <span class="link-none">-</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- 3. 排行榜最后头：下拉菜单与更多榜单总览 (支持选择任意分类展开查阅) -->
  <section class="tier-bottom-dropdown-section" id="cat-more-rankings">
    <div class="bottom-dropdown-card">
      <div class="bottom-dropdown-header">
        <div class="dropdown-header-main">
          <span class="dropdown-header-icon">📑</span>
          <div class="tier-head-text">
            <h4 class="dropdown-header-title">更多榜单与全量明细速查</h4>
            <p class="dropdown-header-desc">从下拉菜单选择任意分类，一键展开查阅该分项完整的实测排行榜数据</p>
          </div>
        </div>

        <div class="dropdown-interactive-bar">
          <div class="dropdown-select-wrapper">
            <select class="ranking-dropdown-select" id="rankingDropdownSelect" aria-label="选择榜单分类">
              <option value={overallCat.id} selected>{overallCat.icon} {overallCat.name} (TOP {overallCat.fullList.length > 50 ? 50 : overallCat.fullList.length})</option>
              {subCategories.map((cat) => (
                <option value={cat.id}>{cat.icon} {cat.name} (TOP {cat.fullList.length > 50 ? 50 : cat.fullList.length})</option>
              ))}
            </select>
          </div>
          <button type="button" class="dropdown-trigger-btn" id="rankingDropdownTriggerBtn" aria-expanded="false">
            <span class="dropdown-btn-arrow">▼</span>
            <span class="dropdown-btn-text">展开查看此榜单</span>
          </button>
        </div>
      </div>

      <!-- 下拉选中的榜单抽屉展示区 -->
      <div class="bottom-dropdown-drawer" id="rankingDropdownDrawer" hidden>
        <div class="bottom-drawer-header">
          <div class="bottom-drawer-title-wrap">
            <h5 class="bottom-drawer-title" id="bottomDrawerTitle">{overallCat.icon} {overallCat.name} · 详细排行榜</h5>
            <span class="bottom-drawer-hint" id="bottomDrawerHint">{overallCat.tagline} · {overallCat.desc}</span>
          </div>
          <div class="bottom-drawer-actions">
            <a href={`#cat-${overallCat.id}`} class="bottom-drawer-jump-link" id="bottomDrawerJumpLink">直达上方天梯图 ↑</a>
