<script type="application/json" id="rankingAllCategoriesData" set:html={categoriesDropdownPayload}></script>

<script>
  function setupTierInteractions() {
    const root = document.querySelector("[data-tier-root]");
    if (!root) return;

    // 1. 各卡片底部的“展开/收起明细”按钮
    const expandTriggers = root.querySelectorAll(".tier-expand-trigger");
    expandTriggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const catId = btn.getAttribute("data-toggle-table");
        const catName = btn.getAttribute("data-cat-name") || "榜单";
        if (!catId) return;

        const drawer = root.querySelector(`[data-drawer-for="${catId}"]`);
        if (!drawer) return;

        const isHidden = drawer.hidden;
        drawer.hidden = !isHidden;
        btn.setAttribute("aria-expanded", String(isHidden));

        const iconEl = btn.querySelector(".expand-icon");
        const textEl = btn.querySelector(".expand-text");

        if (isHidden) {
          btn.classList.add("is-expanded");
          if (iconEl) iconEl.textContent = "▲";
          if (textEl) textEl.textContent = `收起 ${catName} 明细`;
        } else {
          btn.classList.remove("is-expanded");
          if (iconEl) iconEl.textContent = "▼";
          if (textEl) textEl.textContent = `展开 ${catName} 明细 (TOP 50)`;
        }
      });
    });

    // 2. 页面最后头的下拉菜单选择器交互
    const selectEl = root.querySelector("#rankingDropdownSelect") as HTMLSelectElement | null;
    const triggerBtn = root.querySelector("#rankingDropdownTriggerBtn") as HTMLButtonElement | null;
    const drawerEl = root.querySelector("#rankingDropdownDrawer") as HTMLElement | null;
    const titleEl = root.querySelector("#bottomDrawerTitle") as HTMLElement | null;
    const hintEl = root.querySelector("#bottomDrawerHint") as HTMLElement | null;
    const jumpLink = root.querySelector("#bottomDrawerJumpLink") as HTMLAnchorElement | null;
    const closeBtn = root.querySelector("#bottomDrawerCloseBtn") as HTMLButtonElement | null;
    const tableWrap = root.querySelector("#bottomDrawerTableWrap") as HTMLElement | null;

    const dataScript = document.getElementById("rankingAllCategoriesData");
    let categoriesList: Array<any> = [];
    if (dataScript && dataScript.textContent) {
      try {
        categoriesList = JSON.parse(dataScript.textContent);
      } catch (err) {
        console.error("Failed to parse categories data", err);
      }
    }

    function renderBottomCategoryTable(catId: string) {
      if (!tableWrap) return;
      const cat = categoriesList.find((c) => c.id === catId) || categoriesList[0];
      if (!cat) return;

      if (titleEl) {
        titleEl.textContent = `${cat.icon} ${cat.name} · 详细排行榜 (TOP ${cat.fullList.length > 50 ? 50 : cat.fullList.length})`;
      }
      if (hintEl) {
        hintEl.textContent = `${cat.tagline} · ${cat.desc}`;
      }
      if (jumpLink) {
        jumpLink.href = `#cat-${cat.id}`;
        jumpLink.textContent = `直达上方「${cat.name}」天梯图 ↑`;
      }

      const scoreColTitle = cat.isAgent ? "胜率 / 综合得分" : "Elo评分 / 战力";
      let html = `
        <table class="tier-full-table">
          <thead>
            <tr>
              <th style="width: 70px;">排名</th>
              <th>模型名称</th>
              <th style="width: 130px;">研发机构</th>
              <th style="width: 110px;">${scoreColTitle}</th>
              <th style="width: 80px;">链接</th>
            </tr>
          </thead>
          <tbody>
      `;

      cat.fullList.forEach((item: any, rowIdx: number) => {
        const isTop3 = rowIdx < 3;
        const medal = rowIdx === 0 ? "🥇 1" : rowIdx === 1 ? "🥈 2" : rowIdx === 2 ? "🥉 3" : rowIdx + 1;
        const forecastRowClass = item.forecastKey ? `is-forecast is-forecast--${item.forecastKey}` : "";
        const forecastBadge = item.forecastKey
          ? `<span class="table-forecast-badge table-forecast-badge--${item.forecastKey}">预测</span>`
          : "";
        const scoreVal = item.scoreText || (item.rating != null ? (String(item.rating).includes("%") || String(item.rating).includes("分") ? item.rating : `${item.rating}分`) : null);
        const ratingHtml = scoreVal
          ? `<span class="rating-badge">${scoreVal}</span>`
          : `<span class="rating-rank-badge">第 ${item.rank} 名</span>`;
        const linkHtml = item.url
          ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer" class="link-btn">官网 ↗</a>`
          : `<span class="link-none">-</span>`;

        html += `
          <tr class="${isTop3 ? "is-top3" : ""} ${forecastRowClass}">
            <td class="td-rank"><span class="rank-num rank-num--${rowIdx + 1}">${medal}</span></td>
            <td class="td-name"><strong>${item.name}</strong>${forecastBadge}</td>
            <td class="td-org">${item.organization || "-"}</td>
            <td class="td-rating">${ratingHtml}</td>
            <td class="td-link">${linkHtml}</td>
          </tr>
        `;
      });

      html += `
          </tbody>
        </table>
      `;

      tableWrap.innerHTML = html;
    }

    function toggleBottomDrawer(show?: boolean) {
      if (!drawerEl || !triggerBtn || !selectEl) return;
      const shouldShow = typeof show === "boolean" ? show : drawerEl.hidden;
      drawerEl.hidden = !shouldShow;
      triggerBtn.setAttribute("aria-expanded", String(shouldShow));

      const arrowEl = triggerBtn.querySelector(".dropdown-btn-arrow");
      const textEl = triggerBtn.querySelector(".dropdown-btn-text");

      if (shouldShow) {
        triggerBtn.classList.add("is-active");
        if (arrowEl) arrowEl.textContent = "▲";
        if (textEl) textEl.textContent = "收起榜单明细";
        renderBottomCategoryTable(selectEl.value || categoriesList[0]?.id || "agent");
      } else {
        triggerBtn.classList.remove("is-active");
        if (arrowEl) arrowEl.textContent = "▼";
        if (textEl) textEl.textContent = "展开查看此榜单";
      }
    }

    if (triggerBtn) {
      triggerBtn.addEventListener("click", () => toggleBottomDrawer());
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", () => toggleBottomDrawer(false));
    }

    if (selectEl) {
      selectEl.addEventListener("change", () => {
        if (drawerEl && !drawerEl.hidden) {
          renderBottomCategoryTable(selectEl.value);
        }
      });
    }

    // 3. 平滑锚点跳转处理
    const quickLinks = root.querySelectorAll(".quick-nav-chip");
    quickLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          e.preventDefault();
          const targetEl = root.querySelector(href);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTierInteractions);
  } else {
    setupTierInteractions();
  }
</script>

