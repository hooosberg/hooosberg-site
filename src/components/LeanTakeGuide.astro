---
type Props = { locale: "zh-CN" | "en" };
const { locale } = Astro.props;
const zh = locale === "zh-CN";
const base = zh ? "" : "/en";

const t = {
  kicker: zh ? "恰录 LeanTake · 使用说明" : "LeanTake · User guide",
  title: zh ? "使用说明" : "User guide",
  updated: zh ? "最后更新：2026-10-08 · 适用于 恰录 LeanTake 1.0" : "Last updated: 2026-10-08 · For LeanTake 1.0",
  intro: zh
    ? "恰录是一款为讲课和教程设计的 Mac 录屏软件：选好范围、按下录制，停止后直接得到一个能播放的视频文件，不需要导出，也不需要剪辑。这里用最简单的话告诉你怎么用，还有快捷键、免费和 Pro 的区别、常见问题。"
    : "LeanTake is a Mac screen recorder for lessons and tutorials: pick what to record, press Record, and when you stop you already have a playable video. No export step, no editing. This page covers getting started, shortcuts, what is free and what is Pro, and FAQ.",
  toc: zh
    ? [["#quick-start", "5 步录出视频"], ["#recording", "录的时候怎么用"], ["#teleprompter", "提词器"], ["#shortcuts", "快捷键"], ["#free-pro", "免费与 Pro"], ["#permissions", "权限"], ["#faq", "常见问题"], ["#contact", "联系我们"]]
    : [["#quick-start", "Quick start"], ["#recording", "While recording"], ["#teleprompter", "Teleprompter"], ["#shortcuts", "Shortcuts"], ["#free-pro", "Free vs Pro"], ["#permissions", "Permissions"], ["#faq", "FAQ"], ["#contact", "Contact"]],
};

const steps = zh
  ? [
      ["选要录哪里", "工具条最左边有三个按钮：录整个屏幕、录一个窗口、录一小块区域。选“窗口”或“区域”以后，照提示点一下窗口，或者用鼠标拖出一个框。有两块屏幕的话，点“录制屏幕”选一块。"],
      ["想录声音就打开它", "“麦克风”能录你说话；“系统声音”能录电脑自己放出来的声音，比如视频和音乐。点一下，选一个设备。下面的小灯在跳，就是它听得见。"],
      ["想让别人看到你，就开摄像头", "点“摄像头”选一个。屏幕上会出现一个小窗，里面是你，录出来的视频里也会有。"],
      ["点蓝色的“录制”", "屏幕中间会数 3、2、1，然后就开始录了。工具条不会被录进视频里。"],
      ["点“停止”，视频就做好了", "几秒钟后保存完成。点“在访达中显示”就能找到它。它是一个 .mov 文件，双击就能播放，也能直接发给别人。不用再导出，也不用等。"],
    ]
  : [
      ["Choose what to record", "The three buttons on the far left are: record the whole screen, one window, or a small area. For Window or Area, follow the prompt: click a window, or drag a box with the mouse. With two screens, click Display to pick one."],
      ["Turn on the sound you want", "Microphone records your voice. System Audio records sound your Mac plays itself, like videos and music. Click one and pick a device. If the little lights below it jump, it can hear."],
      ["Turn on the camera to be seen", "Click Camera and pick one. A small window with you in it appears on screen, and it will be in the video too."],
      ["Press the blue Record button", "The middle of the screen counts 3, 2, 1, then recording starts. The toolbar is never recorded into the video."],
      ["Press Stop and your video is ready", "It is saved in a few seconds. Click Show in Finder to find it. It is a .mov file: double-click to play, or send it to anyone. No export, no waiting."],
    ];

const recording = zh
  ? [
      ["暂停、停止、重录、取消", "工具条最左边四个按钮。暂停：想喝口水，点一下，回来再点继续。停止：录完了。重录：这段不要，马上重新来。取消：这段不要，也不录了。重录和取消都会先问你一声（弹窗里按回车或 Esc 都是“继续录制”，不会误删）。"],
      ["极简工具条", "想让工具条更小，点最左边的收缩按钮，它会变成一条更短的横条：只留下时间、暂停、停止，以及麦克风和系统声音的图标与竖向电平。再点一下最左边的按钮就展开回来。你的选择会被记住，也可以在 设置 › 通用 里切换。极简模式下，放大镜、画笔、提词器可以点旁边的“工具”按钮，也可以用快捷键；重录和取消用快捷键。"],
      ["工具按钮：单击与长按", "放大镜和画笔按钮：单击是打开或关闭；长按会弹出更多选项——放大镜可选模式、放大倍数和动画速度，画笔可选工具。工具打开后，按 Esc 就能退出。"],
      ["画笔", "点一下，就能在屏幕上画，讲到哪画到哪。旁边的小圆点可以换颜色。再点一下画笔，或按 Esc，画的东西就消失了。长按画笔，还能换成直线、箭头、方框、圆圈和橡皮（这些是 Pro，免费版是铅笔）。"],
      ["放大镜", "让小字看得清楚。有两种模式。跟随光标：点一下，以鼠标为中心放大，你在放大的框里随便动，画面不抖，动到边上才会跟着走。框选区域：点一下，屏幕会变暗、光标变成十字，拖出一个框，就放大到这个框里（Esc 取消，再点一次放大镜按钮也能取消）。用 ⌃⌥] 和 ⌃⌥[ 放大或缩小；暂停的时候也可以先选好位置，继续录制时就会放大。按 Esc 关闭放大镜。"],
      ["摄像头小窗", "用鼠标拖着它走，靠近屏幕角落会自动吸住。想暂时不看自己，点“摄像头”选“隐藏摄像头画面”（视频里的你还在）。"],
      ["临时不想被听到", "点一下“麦克风”选“临时静音”，或者按快捷键。再按一下就恢复。"],
      ["录的时候看不见它们", "工具条、菜单、提词器、设置窗口，都不会被录进视频。"],
    ]
  : [
      ["Pause, Stop, Restart, Cancel", "The four buttons at the left of the toolbar. Pause: need a sip of water? Click it, then click again to continue. Stop: you are done. Restart: throw this take away and start again right now. Cancel: throw it away and stop. Restart and Cancel ask you first (Return or Esc in the dialog means keep recording, so nothing is lost by accident)."],
      ["Compact toolbar", "Click the collapse button at the far left to shrink the toolbar into a shorter strip: just the time, pause, stop, and the microphone and system audio icons with vertical meters. Click the far-left button again to expand. Your choice is remembered and can also be switched in Settings › General. In compact mode the magnifier, pen and teleprompter are one click away in the tools button next to the meters, or by shortcut; restart and cancel use shortcuts."],
      ["Tool buttons: click or press and hold", "On the magnifier and pen buttons, a click turns the tool on or off. Press and hold to open more options: mode, zoom size and speed for the magnifier; tools for the pen. While a tool is on, press Esc to leave it."],
      ["Pen", "Click it to draw on the screen while you talk. The little dot beside it changes the colour. Click the pen again, or press Esc, and the drawing disappears. Long-press the pen to switch to line, arrow, rectangle, circle and eraser (those are Pro; the free version has the pencil)."],
      ["Magnifier", "Makes tiny text easy to read. Two modes. Follow Cursor: click it and the area around your mouse grows to fill the screen; move freely inside the zoom box and the picture stays steady, it only follows you when you reach the edge. Select Region: click it, the screen dims and the cursor becomes a crosshair; drag a box and the video zooms into it (Esc cancels, and clicking the magnifier button again also cancels). Zoom in or out with ⌃⌥] and ⌃⌥[. While paused you can pick the spot first; it zooms when you resume. Press Esc to turn the magnifier off."],
      ["Camera window", "Drag it with the mouse; it snaps to a corner when you get close. To stop looking at yourself for a while, open Camera and choose Hide camera window (you are still in the video)."],
      ["Do not want to be heard for a moment", "Click Microphone and choose Temporary mute, or press the shortcut. Press again to turn it back on."],
      ["You cannot see them in the video", "The toolbar, menus, teleprompter and settings window are never recorded into the video."],
    ];

const shortcuts = zh
  ? [["开始录制", "⌃⌥R"], ["暂停 / 继续", "⌃⌥P"], ["停止录制", "⌃⌥S"], ["麦克风静音", "⌃⌥M"], ["显示 / 隐藏工具条", "⌃⌥H"], ["开关放大镜", "⌃⌥F"], ["放大 / 缩小", "⌃⌥] / ⌃⌥["], ["切换放大镜模式（跟随光标 / 框选区域）", "⌃⌥G"], ["重新框选放大区域", "⌃⌥E"], ["开关画笔", "⌃⌥D"], ["显示 / 隐藏提词器（Pro）", "⌃⌥T"], ["重新录制", "⌃⌥N"], ["取消录制", "⌃⌥C"]]
  : [["Start recording", "⌃⌥R"], ["Pause / Resume", "⌃⌥P"], ["Stop recording", "⌃⌥S"], ["Mute microphone", "⌃⌥M"], ["Show / hide toolbar", "⌃⌥H"], ["Toggle magnifier", "⌃⌥F"], ["Zoom in / out", "⌃⌥] / ⌃⌥["], ["Switch magnifier mode (Follow Cursor / Select Region)", "⌃⌥G"], ["Re-select the magnified region", "⌃⌥E"], ["Toggle pen", "⌃⌥D"], ["Show / hide teleprompter (Pro)", "⌃⌥T"], ["Restart recording", "⌃⌥N"], ["Cancel recording", "⌃⌥C"]];

const freePro = zh
  ? [
      ["录制范围、麦克风、系统声音、暂停、停止即得文件", "免费", "—"],
      ["放大镜；画笔（铅笔、12 种颜色、粗细）", "免费", "—"],
      ["画笔工具：直线、箭头、方框、圆圈、橡皮", "—", "Pro"],
      ["输出分辨率", "720p / 1080p", "1440p、原始分辨率"],
      ["画质与帧率", "低 / 中 / 高画质，24 / 30 帧", "60 帧、自定义码率"],
      ["摄像头", "画进录屏（圆形，720p，15 帧）", "单独保存成文件，更多形状、分辨率和帧率"],
      ["光标", "棉线手套", "全部手套 / 爪子款式（含以后新增的光标主题）、系统光标"],
      ["提词器、配置方案（存多套设置，一键切换）", "—", "Pro"],
    ]
  : [
      ["Display / window / area, microphone, system audio, pause, instant file on stop", "Free", "—"],
      ["Magnifier; pen (pencil, 12 colours, stroke width)", "Free", "—"],
      ["Pen tools: line, arrow, rectangle, circle, eraser", "—", "Pro"],
      ["Output resolution", "720p / 1080p", "1440p, native resolution"],
      ["Quality and frame rate", "Low / medium / high quality, 24 / 30 fps", "60 fps, custom bitrate"],
      ["Camera", "Drawn into the recording (circle, 720p, 15 fps)", "Saved as a separate file, more shapes, resolutions and frame rates"],
      ["Cursor", "Cotton glove", "All glove / paw styles (including future cursor themes), system cursor"],
      ["Teleprompter, configuration profiles (save several setups, switch in one click)", "—", "Pro"],
    ];

const permissions = zh
  ? [
      ["屏幕录制", "录屏必需。第一次录制时 macOS 会请求授权；授权后可能要重新打开恰录才生效。"],
      ["麦克风", "只有你打开麦克风时才会请求。"],
      ["系统音频", "只有你打开“系统声音”时才会请求，用来录电脑播放的声音。"],
      ["摄像头", "只有你打开摄像头时才会请求。"],
    ]
  : [
      ["Screen recording", "Required to record. macOS asks the first time you record; you may need to reopen LeanTake after granting."],
      ["Microphone", "Requested only when you turn the microphone on."],
      ["System audio", "Requested only when you turn on System Audio, to record what your Mac plays."],
      ["Camera", "Requested only when you turn the camera on."],
    ];

const faq = zh
  ? [
      ["录好的文件在哪里？", "默认保存在“影片”文件夹，文件名形如 Recording 2026-10-02 10.30.00.mov。可以在 设置 › 通用 里换保存位置。"],
      ["为什么没有导出按钮？", "恰录刻意不做剪辑和导出：停止录制得到的就是成片（.mov）。如果需要剪辑，可以用任何你喜欢的视频软件打开它。"],
      ["录出来没有声音怎么办？", "先看工具条上麦克风、系统声音的电平有没有跳动，并在 设置 › 授权管理 里确认权限已授权。麦克风一直是纯静音时，录制中会有提示。"],
      ["录系统声音时有回声？", "外放喇叭同时开着麦克风，麦克风会把喇叭的声音又录一遍。戴上耳机，或者在系统声音菜单里选“录制时让喇叭不出声（只录不放）”。"],
      ["iPhone 能当摄像头吗？", "可以。连续互通相机在摄像头菜单里会出现 iPhone；它走无线连接，偶尔会掉线，掉线后在摄像头菜单里重新选择即可。"],
      ["录制中电脑意外重启或软件崩溃，文件还在吗？", "恰录每隔几秒保存一个片段，意外中断后通常能播放到最后几秒之前的内容。"],
      ["怎么购买 Pro？怎么恢复购买？", "在设置里点带 PRO 标记的选项，或打开“账户”页，可以购买或恢复购买。购买通过 Apple 完成，一次性买断，不订阅。"],
      ["怎么存一套自己的设置？", "在 设置 › 通用 最下面点“存为新配置…”，起个名字就行（Pro）。里面包含画面、光标、放大、画笔、摄像头样式、倒计时、极简工具条、提词器样式、快捷键和声音设置，但不包含保存位置和具体的麦克风、摄像头设备。以后一键载入，也可以设一份为默认，每次打开自动用它。"],
      ["画质选低、中、高有什么区别？", "它们对应的是常见视频网站在 1080p 下的画质水平：低约 3 Mbps，中约 6 Mbps，高约 12 Mbps。画面基本不动的讲课，实际文件会小很多。设置 › 录制 里会实时显示 10 分钟大概多大。"],
      ["恰录会上传我的录制吗？", "不会。恰录不联网，录制内容、设置和日志都只保存在你的 Mac 上。详见隐私政策。"],
    ]
  : [
      ["Where are my recordings?", "By default in your Movies folder, named like Recording 2026-10-02 10.30.00.mov. Change the folder in Settings › General."],
      ["Why is there no export button?", "LeanTake deliberately has no editing or export step: stopping gives you the finished .mov. Open it in any editor you like if you need to cut."],
      ["My recording has no sound.", "Check that the microphone and system audio meters on the toolbar move, and confirm access in Settings › Permissions. If the microphone is dead silent you get a notice while recording."],
      ["There is an echo when I record system audio.", "Speakers plus an open microphone record the speaker sound twice. Use headphones, or choose Record without playing through speakers in the System Audio menu."],
      ["Can I use my iPhone as a camera?", "Yes. Continuity Camera shows your iPhone in the Camera menu. It is wireless and may occasionally drop; choose it again in the Camera menu to reconnect."],
      ["What if my Mac restarts or the app crashes mid-recording?", "LeanTake saves a fragment every few seconds, so an interrupted recording can usually be played up to the last few seconds."],
      ["How do I buy Pro or restore a purchase?", "Click any option marked PRO in Settings, or open the Account page, to buy or restore. Purchases go through Apple, one-time, no subscription."],
      ["How do I save my own setup?", "At the bottom of Settings › General, click Save as new profile… and give it a name (Pro). A profile holds picture, cursor, magnifier, pen, camera style, countdown, compact toolbar, teleprompter style, shortcuts and audio settings, but not the save folder or specific microphone and camera devices. Load it in one click, or set one as the default so it loads every time you open the app."],
      ["What do Low, Medium and High quality mean?", "They match typical video-site quality at 1080p: Low is about 3 Mbps, Medium about 6 Mbps, High about 12 Mbps. Mostly still lessons come out much smaller. Settings › Recording shows the estimated size for 10 minutes live."],
      ["Does LeanTake upload my recordings?", "No. LeanTake does not connect to the internet; recordings, settings and logs stay on your Mac. See the privacy policy."],
    ];
---

<section class="legal-page trekreel-support">
  <p class="hero-kicker">{t.kicker}</p>
  <h1>{t.title}</h1>
  <p class="legal-page__updated">{t.updated}</p>
  <p>{t.intro}</p>

  <nav class="trekreel-support__toc" aria-label={zh ? "本页目录" : "On this page"}>
    {t.toc.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>

  <h2 id="quick-start">{zh ? "5 步录出你的第一个视频" : "Quick start: your first recording in 5 steps"}</h2>
  <ol class="trekreel-support__steps">
    {steps.map(([title, body]) => <li><strong>{title}</strong><span>{body}</span></li>)}
  </ol>

  <h2 id="recording">{zh ? "录的时候怎么用" : "While recording"}</h2>
  <ul>
    {recording.map(([title, body]) => <li><strong>{title}：</strong>{body}</li>)}
  </ul>

  <h2 id="teleprompter">{zh ? "提词器（Pro）" : "Teleprompter (Pro)"}</h2>
  <p>{zh ? "把讲稿粘贴进去，点播放，文字会自己往上滚，你边看边讲。提词器不会被录进视频。按 ⌃⌥T 显示或隐藏，按 Esc 关闭，录制前、录制中、极简工具条下都能用；可以在 设置 › 快捷键 里改键位。" : "Paste your script and press play: the text scrolls up while you read along. The teleprompter is never recorded into the video. Press ⌃⌥T to show or hide it and Esc to close it, before or during recording, including in compact mode; change the key in Settings › Shortcuts."}</p>

  <h2 id="shortcuts">{zh ? "默认快捷键" : "Default shortcuts"}</h2>
  <p>{zh ? "全部是全局快捷键（在任何软件里都能按），可以在 设置 › 快捷键 里自定义（自定义的键必须带 ⌘ 或 ⌃）；与其他软件冲突时会有提示。工具条上方有一条淡淡的提示条，会列出你此刻能用的快捷键（键位改了会跟着变），可以在 设置 › 快捷键 里关掉。放大镜、画笔、提词器打开后，按 Esc 就能退出。长按画笔按钮可选画笔工具，长按放大镜按钮可选模式和放大倍数。" : "All shortcuts are global (they work in any app) and can be changed in Settings › Shortcuts (custom keys must include ⌘ or ⌃); conflicts are flagged. A faint hint bar above the toolbar lists the shortcuts you can use right now (it follows any changes you make), and can be turned off in Settings › Shortcuts. With the magnifier, pen or teleprompter on, press Esc to leave it. Long-press the pen button to choose a tool, and the magnifier button to choose the mode and zoom size."}</p>
  <div class="trekreel-support__table">
    <table>
      <thead><tr><th>{zh ? "功能" : "Action"}</th><th>{zh ? "按键" : "Keys"}</th></tr></thead>
      <tbody>{shortcuts.map(([a, k]) => <tr><td>{a}</td><td><kbd>{k}</kbd></td></tr>)}</tbody>
    </table>
  </div>

  <h2 id="free-pro">{zh ? "免费与 Pro" : "Free vs Pro"}</h2>
  <p>{zh ? "免费版就能完整录制，不限时长、没有水印。Pro 是一次性买断（不订阅），解锁更高分辨率、帧率等增值功能。" : "The free version records fully, with no time limit and no watermark. Pro is a one-time purchase (no subscription) that unlocks higher resolutions, frame rates and extras."}</p>
  <div class="trekreel-support__table">
    <table>
      <thead><tr><th>{zh ? "功能" : "Feature"}</th><th>{zh ? "免费" : "Free"}</th><th>Pro</th></tr></thead>
      <tbody>{freePro.map(([a, b, c]) => <tr><td>{a}</td><td>{b}</td><td>{c}</td></tr>)}</tbody>
    </table>
  </div>

  <h2 id="permissions">{zh ? "需要的系统权限" : "Permissions"}</h2>
  <p>{zh ? "可以随时在 macOS「系统设置 › 隐私与安全性」里查看或撤销。" : "You can review or revoke these any time in macOS System Settings › Privacy & Security."}</p>
  <ul>
    {permissions.map(([name, text]) => <li><strong>{name}：</strong>{text}</li>)}
  </ul>

  <h2 id="faq">{zh ? "常见问题" : "FAQ"}</h2>
  <div class="trekreel-support__faq">
    {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </div>

  <h2 id="contact">{zh ? "联系我们" : "Contact"}</h2>
  <p>
    {zh ? "有问题或建议，请发邮件到 " : "Questions or feedback? Email "}
    <a href="mailto:zikedece@proton.me?subject=LeanTake%20support">zikedece@proton.me</a>。
    <a href={`${base}/privacy/leantake`}>{zh ? "隐私政策" : "Privacy Policy"}</a> · <a href={`${base}/terms/leantake`}>{zh ? "服务条款" : "Terms of Service"}</a>
  </p>
</section>

<style>
  .trekreel-support__toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 24px 0 8px;
  }
  .trekreel-support h2 {
    scroll-margin-top: 90px;
  }
  .trekreel-support__steps {
    display: grid;
    gap: 14px;
    padding-left: 22px;
  }
  .trekreel-support__steps li {
    display: grid;
    gap: 4px;
  }
  .trekreel-support__steps strong {
    color: var(--text, inherit);
  }
  .trekreel-support__table {
    overflow-x: auto;
  }
  .trekreel-support table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .trekreel-support th,
