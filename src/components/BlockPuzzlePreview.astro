---
const { locale = "zh-CN" } = Astro.props;
const en = locale === "en";
const questions = en ? [
  ["Does it work offline?", "Core gameplay works offline. Buying or restoring the optional theme pack requires Apple services."],
  ["What is free?", "The complete puzzle, Bamboo theme, scoring, one undo per round and automatic saves are free. Four additional art themes are included in one optional one-time purchase."],
  ["Can I come back to my game?", "Your board saves automatically on your device, so you can leave and continue later."],
  ["Which devices and languages are supported?", "Designed for iPhone and iPad, with 12 interface languages selectable in Settings. The App Store release is in preparation."],
] : [
  ["需要联网吗？", "核心玩法可以离线游玩。购买或恢复可选主题包时，需要连接 Apple 服务。"],
  ["哪些内容免费？", "完整拼放玩法、竹林主题、计分、每局一次撤销和自动存档均免费。另有四款艺术主题，通过一个可选买断包解锁。"],
  ["退出后还能继续吗？", "棋局自动保存在你的设备上，回来后可以继续同一盘面。"],
  ["支持哪些设备和语言？", "为 iPhone 和 iPad 设计，设置中可选择 12 种界面语言。App Store 首发正在筹备中。"],
];
---
<section class="block-preview" aria-label={en ? "How to play" : "玩法介绍"}>
  <p class="eyebrow">{en ? "A LITTLE ROOM TO THINK" : "给思考，留一点空白"}</p>
  <h2>{en ? "A small puzzle. A painted world." : "一盘木块，一幅手绘风景。"}</h2>
  <p>{en ? "Place wooden blocks on a 9×9 board. Complete a row, column or 3×3 square to clear it, then plan ahead as the next three pieces arrive. Bamboo is included; four additional art themes are available together as one optional one-time purchase." : "在 9×9 棋盘上摆放木块，填满一行、一列或一个 3×3 方格即可消除。每次出现三块新木块，提前规划，让棋盘保持空间。竹林主题随游戏提供，另有四款手绘主题包含在一个可选买断包中。"}</p>
  <h2>{en ? "Before you play" : "开始之前"}</h2>
  <div class="faq">{questions.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
</section>
<style>
.block-preview{margin:3.5rem 0;padding:clamp(20px,4vw,48px);background:#f3f0e5;color:#294431;border:1px solid #dedecb;border-radius:24px}.eyebrow{font-size:.75rem;letter-spacing:.15em;color:#647552}.block-preview h2{font-size:clamp(24px,3vw,36px);line-height:1.3}.faq details{border-top:1px solid #cdd1bd;padding:18px 0}.faq summary{font-weight:600;cursor:pointer}.faq p{max-width:780px;line-height:1.8}
</style>
