---
import "../styles/global.css";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import FloatingAdBanner from "../components/FloatingAdBanner.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  absoluteUrl,
  getAlternatePaths,
  getLocaleFromPath,
  localeMeta,
  normalizePath,
  siteName,
  type Locale,
} from "../utils/i18n";

type Props = {
  title?: string;
  description?: string;
  mainClass?: string;
  locale?: Locale;
  canonicalPath?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  image?: string;
  type?: "website" | "article" | "product";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
};

const {
  title = siteName,
  description = "本地优先的 App、AI 工具和真实项目教程。",
  mainClass,
  locale: explicitLocale,
  canonicalPath: explicitCanonicalPath,
  alternatePaths: explicitAlternatePaths,
  image = "/brand/hooosberg-ai-icon.png",
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const currentPath = normalizePath(Astro.url.pathname);
const locale: Locale = explicitLocale ?? getLocaleFromPath(currentPath);
const canonicalPath = normalizePath(explicitCanonicalPath ?? currentPath);
const alternatePaths = { ...getAlternatePaths(canonicalPath), ...explicitAlternatePaths };
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(image);
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const htmlLang = localeMeta[locale]?.htmlLang ?? "zh-CN";
const htmlDir = localeMeta[locale]?.dir ?? "ltr";
const ogLocale = localeMeta[locale]?.ogLocale ?? (locale === "en" ? "en_US" : "zh_CN");
const showFloatingAd =
  currentPath === "/ai-navigation" ||
  currentPath.startsWith("/ai-navigation/") ||
  currentPath === "/en/ai-navigation" ||
  currentPath.startsWith("/en/ai-navigation/") ||
  currentPath === "/blog" ||
  currentPath.startsWith("/blog/") ||
  currentPath === "/en/blog" ||
  currentPath.startsWith("/en/blog/");
---

<!doctype html>
<html
  lang={htmlLang}
  dir={htmlDir}
  data-locale={locale}
  data-en-path={alternatePaths.en}
  data-zh-path={alternatePaths["zh-CN"]}
  data-locale-paths={JSON.stringify(alternatePaths)}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/hooosberg-ai-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {Object.entries(alternatePaths).map(([loc, path]) => (
      <link rel="alternate" hreflang={localeMeta[loc as Locale]?.hreflang || loc} href={absoluteUrl(path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternatePaths.en ?? canonicalPath)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={locale === "en" ? "Hooosberg RSS Feed" : "湖森堡AI RSS 订阅源"}
      href={absoluteUrl(locale === "en" ? "/en/rss.xml" : "/rss.xml")}
    />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type === "article" ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("hooosberg-theme");
          const hour = new Date().getHours();
          const timed = hour >= 18 || hour < 7 ? "dark" : "light";
          document.documentElement.dataset.theme = saved || timed;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const currentLocale = root.dataset.locale;
        const crawlerPattern = /bot|crawler|spider|crawling|google|bing|baidu|yandex|duckduckbot|slurp|facebookexternalhit|twitterbot|linkedinbot|whatsapp/i;
        if (crawlerPattern.test(navigator.userAgent)) return;

        let localePaths = {};
        try {
          localePaths = JSON.parse(root.dataset.localePaths || "{}");
        } catch {}

        const supportedLocales = ["zh-CN", "en", "ja", "ko", "es", "fr", "de", "pt", "ru", "it", "ar", "hi"];

        const getSavedLocale = () => {
          try {
            const saved = localStorage.getItem("hooosberg-locale");
            return saved && supportedLocales.includes(saved) ? saved : "";
          } catch {
            return "";
          }
        };

        const detectBrowserLocale = () => {
          const languages = Array.isArray(navigator.languages) && navigator.languages.length
            ? navigator.languages
            : [navigator.language || ""];

          const langPrefixMap = [
            ["zh", "zh-CN"],
            ["ja", "ja"],
            ["ko", "ko"],
            ["es", "es"],
            ["fr", "fr"],
            ["de", "de"],
            ["pt", "pt"],
            ["ru", "ru"],
            ["it", "it"],
            ["ar", "ar"],
            ["hi", "hi"],
            ["en", "en"],
          ];

          for (const rawLang of languages) {
            const l = (rawLang || "").toLowerCase();
            for (const [prefix, loc] of langPrefixMap) {
              if (l.startsWith(prefix)) {
                return loc;
              }
            }
          }

          return languages.some((language) => language.toLowerCase().startsWith("zh")) ? "zh-CN" : "en";
        };

        const preferredLocale = getSavedLocale() || detectBrowserLocale();
        if (preferredLocale === currentLocale) return;

        const targetPath = localePaths[preferredLocale] || (preferredLocale === "zh-CN" ? root.dataset.zhPath : root.dataset.enPath);
        if (!targetPath) return;

        const targetUrl = new URL(targetPath, window.location.origin);
        targetUrl.search = window.location.search;
        targetUrl.hash = window.location.hash;
        if (targetUrl.pathname !== window.location.pathname) {
          window.location.replace(targetUrl.toString());
        }
      })();
    </script>
    <title>{title}</title>
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
  </head>
  <body>
    <SiteHeader locale={locale} currentPath={canonicalPath} />
    <main class={mainClass}>
      <slot />
    </main>
    <SiteFooter locale={locale} />
    {showFloatingAd && <FloatingAdBanner locale={locale} />}
    <AnalyticsConsent locale={locale} />
  </body>
</html>
